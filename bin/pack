#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# pack — search and manage the knowledge packs
#
# A pack is a domain's accumulated experience: work orders, bugs, behavioral
# test suites, and the architecture behind them. Before specifying anything
# new, search the packs. A problem that has already been solved, tested and
# closed out is a far better starting point than a blank template.
#
#   pack lint [name]                 which catalog entries still have no pitfalls
#   pack list                   list installed packs
#   pack new <name>             scaffold an empty pack
#   pack search <term>          full text across every pack
#   pack wo <term>              work orders only
#   pack bug <term>             bugs only
#   pack suite <term>           behavioral test suites only
#   pack arch <term>            architecture and schema documents
#   pack show <WO-####|BUG-####>  list a folder's documents
#   pack catalog [name]   rebuild CATALOG.md from catalog/ (promotions write entries there)
#   pack index                  regenerate packs/INDEX.md
#
# Scope to one pack with PACK=<name>, e.g. PACK=my-domain pack wo caching
# ---------------------------------------------------------------------------
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
PACKS="$ROOT/packs"
[ -d "$PACKS" ] || mkdir -p "$PACKS"

if [ -n "${PACK:-}" ]; then
  [ -d "$PACKS/$PACK" ] || { echo "pack: no pack named '$PACK'" >&2; exit 1; }
  ROOTS=("$PACKS/$PACK")
else
  ROOTS=()
  for d in "$PACKS"/*/; do [ -d "$d" ] && ROOTS+=("${d%/}"); done
fi
# Commands that read packs need at least one; `new`, `list`, and `index` must
# work on an empty directory, which is the state of every fresh install.
case "${1:-}" in
  search|wo|bug|suite|arch|show)
    [ ${#ROOTS[@]} -gt 0 ] || { echo "pack: no packs yet — nothing to search. 'wo promote <n>' after your first verified work order creates one." >&2; exit 0; };;
esac

hl() { printf '\033[1m%s\033[0m\n' "$*"; }

search_catalog() { # term — catalog entries whose text mentions the term, with their pitfalls
  local term="$1" any=0
  for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
    src="$r/CATALOG.md"; [ -n "$(ls -A "$r/catalog" 2>/dev/null)" ] && src="$r/catalog"
    [ -e "$src" ] || continue
    python3 - "$src" "$term" "$(basename "$r")" <<'PYEOF' && any=1
import re, sys, os, glob
path, term, pack = sys.argv[1:4]
if os.path.isdir(path):
    t = "".join(open(f).read().rstrip("\n") + "\n\n" for f in sorted(glob.glob(os.path.join(path, "*.md"))))
else:
    t = open(path).read()
entries = re.split(r"(?m)^## ", t)[1:]
hits = [e for e in entries if re.search(re.escape(term), e, re.I)]
if not hits: sys.exit(1)
print("\033[1mCATALOG — %s\033[0m" % pack)
for e in hits:
    head, _, body = e.partition("\n")
    folder = re.search(r"\*\*Folder:\*\* `([^`]+)`", body)
    pit = re.search(r"(?ms)\*\*Pitfalls:\*\*\n(.*?)(?=\n- \*\*|\Z)", body)
    print("  " + head.strip())
    if folder: print("    folder:   " + folder.group(1))
    if pit:
        for line in [l.strip() for l in pit.group(1).splitlines() if l.strip()][:4]: print("    pitfall:  " + line)
print()
PYEOF
  done
  return 0
}
search_sub() { # subdir term label — folders under the pack whose documents mention the term
  local sub="$1" term="$2" label="$3" any=0 hits
  for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
    [ -d "$r/$sub" ] || continue
    hits="$(grep -rils --include='*.md' -- "$term" "$r/$sub" 2>/dev/null | grep -v '\.log$\|\.wo-meta' | xargs -n1 dirname 2>/dev/null | sort -u | head -20 || true)"
    [ -z "$hits" ] && continue
    [ "$any" -eq 0 ] && { hl "$label"; any=1; }
    echo "$hits" | sed "s|$PACKS/|  |"
  done
  [ "$any" -eq 1 ] && echo
  return 0
}

case "${1:-}" in
  new)
    name="${2:?usage: pack new <name>}"
    case "$name" in *[!a-z0-9-]*) echo "pack: name must be lowercase letters, digits, hyphens" >&2; exit 1;; esac
    d="$PACKS/$name"; [ -e "$d" ] && { echo "pack: $d already exists" >&2; exit 1; }
    mkdir -p "$d/catalog"; printf '# Generated from catalog/ by `pack catalog`; the entry files are the source of truth.\nCATALOG.md\n' > "$d/.gitignore"
    mkdir -p "$d"/{workorders,bugs,test-suites,architecture}
    for sub in workorders bugs test-suites architecture; do : > "$d/$sub/.gitkeep"; done
    cat > "$d/README.md" <<MD
# Pack: $name

Accumulated experience for this domain. \`wo promote\` and \`bug promote\` add
verified, sanitized work into it and append entries to \`CATALOG.md\`.

| Folder | Holds |
|---|---|
| \`workorders/<project>/\` | promoted work orders, structure intact |
| \`bugs/\` | promoted bug folders |
| \`test-suites/\` | behavioral suites worth reusing |
| \`architecture/\` | design documents and schema |
| \`catalog/\` | one file per promoted item, with pitfalls (edit these) |
| \`CATALOG.md\` | generated from \`catalog/\` by \`pack catalog\` |

Run \`bin/sanitize\` on this pack before sharing it.
MD
    echo "pack created: $d"
    ;;
  lint)
    # The pitfalls are the part of a pack the next project needs, and promote
    # asks for them rather than refusing. This is where the asking gets checked.
    name="${2:-}"; rc=0; total=0; empty=0
    for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
      [ -n "$name" ] && [ "$(basename "$r")" != "$name" ] && continue
      for e in "$r"/catalog/*.md; do
        [ -f "$e" ] || continue
        total=$((total+1))
        if grep -qE '_\(none recorded|\[Lesson [0-9]|\[What would have saved' "$e" 2>/dev/null; then empty=$((empty+1)); echo "  no pitfalls recorded: ${e#$PACKS/}"; rc=1; fi
      done
    done
    [ "$total" -gt 0 ] || { echo "pack lint: no catalog entries yet"; exit 0; }
    echo "pack lint: $total entries, $empty without pitfalls"
    [ "$rc" -eq 0 ] && echo "  every entry carries what would have saved someone time" || echo "  edit the Pitfalls lines above; a pack of placeholders is process without precedent"
    exit "$rc";;
  list|packs)
    [ ${#ROOTS[@]} -gt 0 ] || { echo "no packs yet — pack new <name>, then wo promote"; exit 0; }
    printf "%-24s %8s %10s  %s\n" "PACK" "FILES" "SIZE" "CONTENTS"
    for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
      c=""
      for s in workorders bugs test-suites architecture audits reference ui-scenarios; do
        [ -d "$r/$s" ] && c="$c $s"
      done
      printf "%-24s %8s %10s %s\n" "$(basename "$r")" \
        "$(find "$r" -type f | wc -l | tr -d ' ')" "$(du -sh "$r" | cut -f1)" "$c"
    done
    ;;
  search)
    t="${2:?usage: pack search <term>}"
    search_catalog "$t"
    search_sub workorders   "$t" "WORK ORDERS"
    search_sub bugs         "$t" "BUGS"
    search_sub test-suites  "$t" "TEST SUITES"
    search_sub architecture "$t" "ARCHITECTURE"
    ;;
  wo)    search_sub workorders   "${2:?usage: pack wo <term>}"    "WORK ORDERS";;
  bug)   search_sub bugs         "${2:?usage: pack bug <term>}"   "BUGS";;
  suite) search_sub test-suites  "${2:?usage: pack suite <term>}" "TEST SUITES";;
  arch)  search_sub architecture "${2:?usage: pack arch <term>}"  "ARCHITECTURE";;
  show)
    id="${2:?usage: pack show <WO-####|BUG-####>}"; found=0
    for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
      while IFS= read -r d; do
        found=1; hl "${d#$PACKS/}"; ls "$d" | sed 's/^/    /'; echo
      done < <(find "$r" -type d -iname "${id}*" 2>/dev/null)
    done
    if [ "$found" -eq 0 ]; then echo "pack: no folder matching $id" >&2; exit 1; fi
    ;;
  catalog)
    want="${2:-}"
    for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
      pack="$(basename "$r")"; [ -n "$want" ] && [ "$want" != "$pack" ] && continue
      mkdir -p "$r/catalog"
      # migrate a legacy single-file catalog into per-item entries once
      if [ -f "$r/CATALOG.md" ] && [ -z "$(ls -A "$r/catalog" 2>/dev/null)" ] && grep -q "^## " "$r/CATALOG.md"; then
        python3 - "$r/CATALOG.md" "$r/catalog" <<'PYEOF'
import re, sys, os, pathlib
src, out = sys.argv[1:3]
t = open(src).read()
for m in re.finditer(r"(?ms)^## ((?:WO|BUG)-\d+)[^\n]*\n.*?(?=^## |\Z)", t):
    pathlib.Path(out, m.group(1) + ".md").write_text(m.group(0).rstrip("\n") + "\n")
print(f"  migrated {len(re.findall(r'(?m)^## (?:WO|BUG)-', t))} legacy catalog entr(ies) into catalog/")
PYEOF
      fi
      # CATALOG.md is generated from catalog/; keeping it untracked is what makes
      # concurrent promotions merge cleanly. The entries are the source of truth.
      printf '# Generated from catalog/ by `pack catalog`; the entry files are the source of truth.\nCATALOG.md\n' > "$r/.gitignore"
      { printf '# Pack catalog: %s\n\n' "$pack"
        printf 'Generated by `pack catalog` from `catalog/`. One file per promoted item, so\n'
        printf 'parallel promotions never touch the same file. Edit the **Pitfalls** lines in\n'
        printf 'the entry files — they are the most valuable part.\n\n'
        for f in "$r"/catalog/*.md; do [ -f "$f" ] && { cat "$f"; printf '\n'; }; done
      } > "$r/CATALOG.md"
      echo "wrote $r/CATALOG.md ($(ls "$r"/catalog/*.md 2>/dev/null | wc -l | tr -d ' ') entries)"
    done
    ;;
  index)
    out="$PACKS/INDEX.md"
    if [ ${#ROOTS[@]} -eq 0 ]; then
      printf '# Pack Index\n\nNo packs yet. Create one with `pack new <name>`, then `wo promote` verified work into it.\n' > "$out"
      echo "wrote $out (no packs)"; exit 0
    fi
    {
      echo "# Pack Index"
      echo
      echo "Generated by \`bin/pack index\`. Search with \`bin/pack search <term>\`."
      echo
      echo "Lifecycle notation: \`SCTPVC\` = **S**pec, **C**hecklist,"
      echo "**T**ask-breakdown, **P**rompt, **V**erification, **C**loseout."
      echo "A dot is a document that was never written."
      echo
      for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
        pack="$(basename "$r")"
        echo "---"; echo; echo "# Pack: $pack"; echo
        for d in "$r"/workorders/*/; do
          [ -d "$d" ] || continue
          echo "## Work orders — $(basename "$d") ($(find "$d" -maxdepth 1 -type d | tail -n +2 | wc -l | tr -d ' '))"
          echo; echo "| WO | Docs | Title |"; echo "|---|---|---|"
          for f in "$d"WO-*; do
            [ -d "$f" ] || continue
            b="$(basename "$f")"; n="${b#WO-}"; n="${n%%-*}"; st=""
            for k in SPEC CHECKLIST TASK-BREAKDOWN Prompt VERIFICATION CLOSEOUT; do
              if ls "$f" 2>/dev/null | grep -qi -- "-$k"; then st="$st${k:0:1}"; else st="$st."; fi
            done
            echo "| WO-$n | \`$st\` | ${b#WO-$n-} |"
          done
          echo
        done
        if [ -d "$r/bugs" ]; then
          echo "## Bugs ($(find "$r/bugs" -maxdepth 1 -type d | tail -n +2 | wc -l | tr -d ' '))"
          echo; echo "| Bug | State | Title |"; echo "|---|---|---|"
          for f in "$r"/bugs/BUG-*; do
            [ -d "$f" ] || continue
            b="$(basename "$f")"; n="${b#BUG-}"; n="${n%%-*}"
            if ls "$f" 2>/dev/null | grep -qi CLOSEOUT; then s=fixed; else s=open; fi
            echo "| BUG-$n | $s | ${b#BUG-$n-} |"
          done
          echo
        fi
        if [ -d "$r/test-suites" ]; then
          echo "## Behavioral test suites ($(ls "$r"/test-suites/*.sh 2>/dev/null | wc -l | tr -d ' '))"
          echo
          for f in "$r"/test-suites/*.sh; do
            [ -f "$f" ] && echo "- \`$(basename "$f")\` ($(wc -l < "$f" | tr -d ' ') lines)"
          done
          echo
        fi
      done
    } > "$out"
    echo "wrote $out ($(wc -l < "$out" | tr -d ' ') lines)"
    ;;
  *) sed -n '2,21p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1;;
esac
