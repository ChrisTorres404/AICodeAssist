#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# bug — bug lifecycle driver
#
# Implements core/methodology/MANDATORY-BUG-METHODOLOGY.md:
#   * every bug is a FOLDER named BUG-XXXX-<slug>
#   * the issue document is created from the template at open time
#   * a closeout may not be produced before a verification exists
#
#   bug new "<title>" [--category C] [--series N] [--prompt]
#       categories (each owns a number series and a routing):
#         auth 0001  api 0100  database 0200  ui 0300  observability 0400
#         security 0500  performance 0600  integration 0700  config 0800  docs 0900
#   bug list
#   bug status <number>
#   bug verify <number> [--run <suite.sh>]   create VERIFICATION; with --run, execute and record
#   bug close <number>
#   bug promote <number> [--pack <name>] [--allow-unsanitized]
# ---------------------------------------------------------------------------
set -euo pipefail

PIPELINE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEMPLATES="$PIPELINE_ROOT/core/templates/bugs"

find_config() {
  local d="$PWD"
  while [ "$d" != "/" ]; do
    [ -f "$d/pipeline.config.sh" ] && { echo "$d/pipeline.config.sh"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}
CONFIG="$(find_config || true)"
if [ -n "$CONFIG" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG"
  PROJECT_ROOT="${PROJECT_ROOT:-$(dirname "$CONFIG")}"
  BUG_DIR="$PROJECT_ROOT/${BUGS_DIR:?BUGS_DIR not set in pipeline.config.sh}"
else
  PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  BUG_DIR="$PROJECT_ROOT/${BUGS_DIR:-Workspace/Docs/Bugs}"
fi

die() { echo "bug: $*" >&2; exit 1; }
slugify() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9][^a-z0-9]*/-/g' -e 's/^-//' -e 's/-$//'; }
bug_folder() { find "$BUG_DIR" -maxdepth 1 -type d -name "BUG-$1-*" -print -quit 2>/dev/null; }

next_number() {
  local series="${1:-}" max=0 n
  for d in "$BUG_DIR"/BUG-*; do
    [ -d "$d" ] || continue
    n="$(basename "$d")"; n="${n#BUG-}"; n="${n%%-*}"
    case "$n" in ''|*[!0-9]*) continue;; esac
    [ -n "$series" ] && { [ "${n:0:${#series}}" = "$series" ] || continue; }
    [ "$((10#$n))" -gt "$max" ] && max="$((10#$n))"
  done
  if [ "$max" -eq 0 ] && [ -n "$series" ]; then printf '%04d' "$((10#$series))"
  else printf '%04d' "$((max + 1))"; fi
}

render() { sed -e "s/BUG-XXXX/BUG-$3/g" -e "s/\[Title\]/$4/g" -e "s/YYYY-MM-DD/$(date +%F)/g" "$1" > "$2"; }

route() { # category -> "series|investigate|fix|validate"
  case "$1" in
    auth)          echo "0001|support-engineer-expert + jwt-expert|jwt-expert, oauth-oidc-expert, or iam-rbac-expert|owasp-top10-expert, then project-validator-expert";;
    api)           echo "0100|support-engineer-expert + rest-expert|the stack's backend specialist|project-validator-expert";;
    database|db)   echo "0200|database-validator-expert + postgres-expert|postgres-expert or typeorm-expert|database-validator-expert";;
    ui|frontend)   echo "0300|support-engineer-expert + react-expert|the stack's UI specialist|frontend-validator-expert";;
    observability) echo "0400|support-engineer-expert + prometheus-expert|prometheus-expert or grafana-expert|project-validator-expert";;
    security)      echo "0500|owasp-top10-expert + support-engineer-expert|jwt-expert, iam-rbac-expert, or owasp-top10-expert|owasp-top10-expert, then project-validator-expert";;
    performance|perf) echo "0600|support-engineer-expert + postgres-expert|nodejs-expert, postgres-expert, or redis-expert|project-validator-expert";;
    integration)   echo "0700|support-engineer-expert + rest-expert|the stack's backend specialist or websocket-expert|project-validator-expert";;
    config|deployment) echo "0800|support-engineer-expert + docker-expert|docker-expert or github-actions-expert|project-validator-expert";;
    docs|documentation) echo "0900|documentation-expert|documentation-expert|documentation-expert";;
    *) return 1;;
  esac
}

cmd_new() {
  local title="" series="" want_prompt=0 category=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --category) category="$2"; shift 2;;
      --series) series="$2"; shift 2;;
      --prompt) want_prompt=1; shift;;
      -*) die "unknown flag $1";;
      *)  title="$1"; shift;;
    esac
  done
  [ -n "$title" ] || die 'usage: bug new "<title>" [--category C] [--series N] [--prompt]'
  local routing="" investigate="" fix="" validate=""
  if [ -n "$category" ]; then
    routing="$(route "$category")" || die "unknown category '$category' — auth api database ui observability security performance integration config docs"
    [ -n "$series" ] || series="${routing%%|*}"
    investigate="$(printf '%s' "$routing" | cut -d'|' -f2)"; fix="$(printf '%s' "$routing" | cut -d'|' -f3)"; validate="$(printf '%s' "$routing" | cut -d'|' -f4)"
  fi
  mkdir -p "$BUG_DIR"
  [ -n "$series" ] || series="1000"   # uncategorised bugs go to the overflow series, as the methodology says
  local num slug dir
  num="$(next_number "$series")"; slug="$(slugify "$title")"
  dir="$BUG_DIR/BUG-$num-$slug"
  [ -e "$dir" ] && die "$dir already exists"
  mkdir -p "$dir"
  render "$TEMPLATES/BUG-TEMPLATE-ISSUE.md" "$dir/BUG-$num-$slug.md" "$num" "$title"
  [ "$want_prompt" -eq 1 ] && render "$TEMPLATES/BUG-TEMPLATE-PROMPT.md" "$dir/BUG-$num-Prompt.md" "$num" "$title"
  printf 'title=%s\ncreated=%s\nowner=%s\n' "$title" "$(date +%F)" "$(git config user.name 2>/dev/null || whoami)" > "$dir/.bug-meta"
  if [ -n "$category" ]; then
    printf 'category=%s\ninvestigate=%s\nfix=%s\nvalidate=%s\n' "$category" "$investigate" "$fix" "$validate" >> "$dir/.bug-meta"
    # the routing goes at the top of the issue document so whoever opens it sees it first
    python3 - "$dir/BUG-$num-$slug.md" "$category" "$investigate" "$fix" "$validate" <<'PYEOF'
import sys, pathlib
p = pathlib.Path(sys.argv[1]); s = p.read_text()
block = ("\n> **Category:** %s  \n> **Investigate with:** %s  \n> **Fix with:** %s  \n> **Validate with:** %s  \n> Investigators return findings with file:line; they do not edit. A different agent validates the fix.\n" % tuple(sys.argv[2:6]))
lines = s.split("\n", 1)
p.write_text(lines[0] + "\n" + block + ("\n" + lines[1] if len(lines) > 1 else ""))
PYEOF
  fi
  echo "BUG-$num opened: $dir"
  ls "$dir" | sed 's/^/    /'
  if [ -n "$category" ]; then
    echo
    echo "Routing ($category):"
    echo "  investigate with : $investigate"
    echo "  fix with         : $fix"
    echo "  validate with    : $validate"
  else
    echo
    echo "No --category given. Decide the routing before investigating:"
    echo "  auth api database ui observability security performance integration config docs"
  fi
  echo
  echo "Closeout is blocked until BUG-$num-VERIFICATION.md exists."
}

cmd_list() {
  printf "%-9s %-8s %-14s %s\n" "BUG" "STATE" "CATEGORY" "TITLE"
  for d in "$BUG_DIR"/BUG-*; do
    [ -d "$d" ] || continue
    local b n state
    b="$(basename "$d")"; n="${b#BUG-}"; n="${n%%-*}"
    if ls "$d" | grep -qi -- "CLOSEOUT"; then state="fixed"; else state="open"; fi
    local cat; cat="$( [ -f "$d/.bug-meta" ] && sed -n 's/^category=//p' "$d/.bug-meta" || true)"
    printf "%-9s %-8s %-14s %s\n" "BUG-$n" "$state" "${cat:--}" "${b#BUG-$n-}"
  done
}

cmd_status() {
  local n="${1:-}"; [ -n "$n" ] || die "usage: bug status <number>"
  local d; d="$(bug_folder "$n")"; [ -n "$d" ] || die "no BUG-$n under $BUG_DIR"
  echo "BUG-$n  $d"; echo
  ls "$d" | grep -qiv -- "-\(CLOSEOUT\|VERIFICATION\|Prompt\)" && echo "  [x] issue document" || echo "  [ ] issue document — MISSING"
  for k in VERIFICATION CLOSEOUT Prompt; do
    ls "$d" | grep -qi -- "$k" && echo "  [x] $k" || echo "  [ ] $k"
  done
}

render_v() { sed -e "s/BUG-XXXX/BUG-$3/g; s/WO-XXXX/BUG-$3/g" -e "s/\[Title\]/$4/g" -e "s/YYYY-MM-DD/$(date +%F)/g" "$1" > "$2"; }

cmd_verify() {
  local n="" suite="" force=0
  while [ $# -gt 0 ]; do case "$1" in --run) suite="$2"; shift 2;; --force) force=1; shift;; -*) die "unknown flag $1";; *) n="$1"; shift;; esac; done
  [ -n "$n" ] || die "usage: bug verify <number> [--run <suite.sh>]"
  local d; d="$(bug_folder "$n")"; [ -n "$d" ] || die "no BUG-$n"
  local out="$d/BUG-$n-VERIFICATION.md"
  if [ ! -f "$out" ] || [ "$force" -eq 1 ]; then
    render_v "$PIPELINE_ROOT/core/templates/testing/TEST-TEMPLATE-VERIFICATION.md" "$out" "$n" "$(basename "$d")"
    printf '\n---\n\n## Execution Record\n\n**Overall status:** NOT EXECUTED — PLAN ONLY\n\n' >> "$out"
    echo "BUG-$n verification document created: $out"
  fi
  [ -z "$suite" ] && { echo "Status is NOT EXECUTED — PLAN ONLY until you run something:  bug verify $n --run <suite.sh>"; return 0; }
  [ -f "$suite" ] || die "suite not found: $suite"
  local stamp log rc status; stamp="$(date +%Y%m%d-%H%M%S)"; log="$d/BUG-$n-VERIFICATION-$stamp.log"
  set +e; bash "$suite" >"$log" 2>&1; rc=$?; set -e
  if [ "$rc" -eq 0 ]; then status="EXECUTED — PASS"; else status="EXECUTED — FAIL"; fi
  { printf '\n### Run %s\n\n- **Status:** %s\n- **Command:** `bash %s`\n- **Exit code:** %s\n- **Log:** `%s`\n\n```\n' "$stamp" "$status" "$suite" "$rc" "$(basename "$log")"; tail -60 "$log"; printf '```\n'; } >> "$out"
  perl -pi -e "s/^\*\*Overall status:\*\* .*/**Overall status:** $status (last run $stamp)/" "$out"
  echo "$status (exit $rc) — recorded in $(basename "$out")"
  [ "$rc" -eq 0 ] || return 1
}

cmd_promote() {
  local n="" pack="" allow=0
  while [ $# -gt 0 ]; do case "$1" in --pack) pack="$2"; shift 2;; --allow-unsanitized) allow=1; shift;; -*) die "unknown flag $1";; *) n="$1"; shift;; esac; done
  [ -n "$n" ] || die "usage: bug promote <number> [--pack <name>] [--allow-unsanitized]"
  local d; d="$(bug_folder "$n")"; [ -n "$d" ] || die "no BUG-$n"
  ls "$d" | grep -qi -- "VERIFICATION" || die "refusing to promote BUG-$n: not verified."
  [ -x "$PIPELINE_ROOT/bin/sanitize" ] || die "bin/sanitize is missing — refusing to promote unscanned work."
  local rc=0; "$PIPELINE_ROOT/bin/sanitize" "$d" --quiet >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 2 ] && [ "$allow" -eq 0 ]; then die "refusing to promote BUG-$n: fails sanitization. Fix, or pass --allow-unsanitized for a private pack."; fi
  local slug; slug="$(basename "$PROJECT_ROOT" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9][^a-z0-9]*/-/g')"
  slug="${PROJECT_SLUG:-$slug}"; pack="${pack:-$slug}"
  local pdir="${PACKS_DIR:-$PIPELINE_ROOT/packs}/$pack"; mkdir -p "$pdir/bugs"
  local b; b="$(basename "$d")"; rm -rf "$pdir/bugs/$b"; cp -R "$d" "$pdir/bugs/$b"
  local cat="$pdir/CATALOG.md" issue close root fix
  issue="$(ls "$d"/BUG-$n-*.md | grep -v -- "-\(CLOSEOUT\|VERIFICATION\|Prompt\)" | head -1 || true)"
  close="$d/BUG-$n-${b#BUG-$n-}-CLOSEOUT.md"; [ -f "$close" ] || close=""
  section() { awk -v h="$2" 'BEGIN{p=0} /^## /{p=($0 ~ h)} p&&!/^## /{print}' "$1" | sed -e '/^\s*$/d' -e '/^---*$/d' | head -${3:-6}; }
  root="$( { [ -n "$close" ] && section "$close" "Root Cause" 6; } || { [ -n "$issue" ] && section "$issue" "Root Cause" 6; } || true)"
  fix="$( [ -n "$close" ] && section "$close" "(Fix|Resolution|Solution)" 6 || true)"
  [ -f "$cat" ] || printf '# Pack catalog: %s\n\n' "$pack" > "$cat"
  { printf '## BUG-%s — %s\n\n- **Folder:** `bugs/%s`\n- **Promoted:** %s from project `%s`\n' "$n" "${b#BUG-$n-}" "$b" "$(date +%F)" "$slug"
    [ -n "$root" ] && { printf -- '- **Root cause:**\n'; printf '%s\n' "$root" | sed 's/^/    /'; }
    [ -n "$fix" ]  && { printf -- '- **Fix:**\n'; printf '%s\n' "$fix" | sed 's/^/    /'; }
    printf -- '- **Pitfalls:**\n    _(what would have found this faster? add it)_\n\n'; } >> "$cat"
  echo "BUG-$n promoted to pack '$pack'. Catalog: $cat — edit the Pitfalls line now."
}

cmd_close() {
  local n="${1:-}"; [ -n "$n" ] || die "usage: bug close <number>"
  local d; d="$(bug_folder "$n")"; [ -n "$d" ] || die "no BUG-$n under $BUG_DIR"
  ls "$d" | grep -qi -- "VERIFICATION" \
    || die "refusing to close BUG-$n: no BUG-$n-VERIFICATION.md.
    The methodology forbids a closeout without executed-test evidence."
  local slug out; slug="$(basename "$d")"; slug="${slug#BUG-$n-}"
  out="$d/BUG-$n-$slug-CLOSEOUT.md"
  [ -e "$out" ] && die "$out already exists"
  render "$TEMPLATES/BUG-TEMPLATE-CLOSEOUT.md" "$out" "$n" "$slug"
  echo "BUG-$n closeout drafted: $out"
}

case "${1:-}" in
  new) shift; cmd_new "$@";;
  list) shift; cmd_list;;
  status) shift; cmd_status "${1:-}";;
  verify) shift; cmd_verify "$@";;
  promote) shift; cmd_promote "$@";;
  close) shift; cmd_close "${1:-}";;
  *) sed -n '2,17p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1;;
esac
