#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# wo — work order lifecycle driver
#
# Implements the rules in core/methodology/MANDATORY-WO-METHODOLOGY.md:
#   * every work order is a FOLDER, never a loose .md
#   * four documents are required at creation
#   * a closeout may not be produced before a verification exists
#
#   wo new "<title>" [--size trivial|small|standard|large] [--area A] [--series N] [--paths a,b]
#   wo adopt <file.md> --number N [--status migrated]   bring an existing record in, recorded and never verified
#   wo suite <number> [--wrap '<cmd>']   scaffold a suite, or wrap the runner the project already has
#                    [--priority P0|P1|P2|P3] [--sdk] [--ui]
#       --area routes the work: backend api database auth rbac frontend ui
#              styling testing cicd docker security performance docs analysis integration
#   wo list [--open|--active|--closed]   (--active: everything not closed)
#   wo show <number>                 print the work order's primary document
#   wo status <number>               which documents exist, which are missing
#   wo start <number>                mark in progress
#   wo block <number> "<reason>"     mark blocked
#   wo note <number> "<text>"        append a dated session note
#   wo suite <number>                       scaffold a behavioural suite for the work order
#   wo integrate "<title>" --covers N,N,N   open the integration work order for a batch of parallel work orders
#   wo verify <number> [--run <suite.sh>]   create the VERIFICATION document;
#                                    with --run, execute the suite and record
#                                    EXECUTED — PASS/FAIL from its exit code
#   wo close <number>
#   wo promote <number> [--pack <name>] [--allow-unsanitized]
#   wo stats                         cycle time, evidence rate, drift
#
# Working with others (needs the gh CLI, authenticated):
#   wo publish <number>              open a GitHub issue carrying the work order
#   wo sync <number>                 push the current spec and status to the issue
#   wo import <issue-number>         create a work order from an existing issue
# The folder stays the local record; the issue is the shared view. verify --run
# comments the result on the issue; close closes it.
#
# Size sets the ceremony:  trivial = one document + verification
#                          small    = SPEC + verification
#                          standard = SPEC, CHECKLIST, TASK-BREAKDOWN, Prompt (default)
#                          large    = standard + sdk and ui implementation docs
# Every size requires VERIFICATION before close. That never relaxes.
# ---------------------------------------------------------------------------
set -euo pipefail

PIPELINE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SELF_ROOT="$PIPELINE_ROOT"
TEMPLATES="$PIPELINE_ROOT/core/templates/workorders"; [ -d "$TEMPLATES" ] || TEMPLATES="$PIPELINE_ROOT/templates/workorders"   # plugin layout
TESTING_TEMPLATES="$(dirname "$TEMPLATES")/testing"

# Resolve where work orders live: pipeline.config.sh in cwd or any parent.
find_config() {
  local d="$PWD"
  while [ "$d" != "/" ]; do
    [ -f "$d/pipeline.config.sh" ] && { echo "$d/pipeline.config.sh"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}
CONFIG="$(find_config || true)"
if [ -n "$CONFIG" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG"
  PIPELINE_ROOT="$SELF_ROOT"   # the config's PIPELINE_ROOT is the project's install path; ours is where this script lives
  PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$(dirname "$CONFIG")" && pwd -P)}"
  # The config resolves its own location logically; under a symlinked path that is a
  # different string from the physical one, and every exclusion below is a prefix match.
  PROJECT_ROOT="$(cd "$PROJECT_ROOT" 2>/dev/null && pwd -P || printf '%s' "$PROJECT_ROOT")"
  WO_DIR="$PROJECT_ROOT/${WORKORDERS_DIR:?WORKORDERS_DIR not set in pipeline.config.sh}"
else
  # No binding file: fall back to the git root and the default layout, so the
  # pipeline works as a plugin without an install step.
  PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
  WORKORDERS_DIR="${WORKORDERS_DIR:-Workspace/Docs/WorkOrders}"
  WO_DIR="$PROJECT_ROOT/$WORKORDERS_DIR"
fi
PACKS_DIR="${PACKS_DIR:-$PIPELINE_ROOT/packs}"
PROJECT_SLUG="${PROJECT_SLUG:-$(basename "$PROJECT_ROOT" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9][^a-z0-9]*/-/g')}"

die() { echo "wo: $*" >&2; exit 1; }
slugify() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9][^a-z0-9]*/-/g' -e 's/^-//' -e 's/-$//'; }

meta_get() { # dir key -> value
  [ -f "$1/.wo-meta" ] && sed -n "s/^$2=//p" "$1/.wo-meta" | head -1 || true
}
meta_set() { # dir key value
  local f="$1/.wo-meta"; touch "$f"
  if grep -q "^$2=" "$f"; then
    perl -pi -e "s/^\Q$2\E=.*/$2=$3/" "$f"
  else
    printf '%s=%s\n' "$2" "$3" >> "$f"
  fi
}
primary_doc() { # dir number -> path of SPEC or MAIN document
  if [ -f "$1/WO-$2-SPEC.md" ]; then echo "$1/WO-$2-SPEC.md"; return; fi
  for f in "$1"/WO-$2-*.md; do
    case "$(basename "$f")" in *-CHECKLIST*|*-TASK-BREAKDOWN*|*-Prompt*|*-VERIFICATION*|*-CLOSEOUT*|*-REVIEW*|*-sdk-*|*-ui-*) ;; *) echo "$f"; return;; esac
  done
}
required_docs() { # size -> space-separated doc keys
  case "${1:-standard}" in
    trivial)  echo "MAIN";;
    small)    echo "SPEC";;
    large)    echo "SPEC CHECKLIST TASK-BREAKDOWN Prompt REVIEW sdk-implementation ui-implementation";;
    *)        echo "SPEC CHECKLIST TASK-BREAKDOWN Prompt REVIEW";;
  esac
}
has_doc() { # dir number key
  if [ "$3" = "MAIN" ]; then
    ls "$1" 2>/dev/null | grep -v -- "-\(SPEC\|CHECKLIST\|TASK-BREAKDOWN\|Prompt\|VERIFICATION\|CLOSEOUT\|REVIEW\|sdk-implementation\|ui-implementation\)" | grep -qi -- "^WO-$2-.*\.md$"
  elif [ "$3" = "REVIEW" ]; then
    ls "$1" 2>/dev/null | grep -qi -- "^WO-$2-\(INDEPENDENT-\)\{0,1\}REVIEW\.md$"
  else
    ls "$1" 2>/dev/null | grep -qi -- "WO-$2-$3"
  fi
}

wo_folder() { # number -> path, or empty. Two folders sharing a number is not a
  # thing to resolve by picking one: whichever is chosen, the other record becomes
  # unaddressable and every later command silently acts on the wrong work order.
  local hits n
  hits="$(find "$WO_DIR" -maxdepth 1 -type d -name "WO-$1-*" 2>/dev/null | sort)"
  [ -z "$hits" ] && return 0
  n="$(printf '%s\n' "$hits" | grep -c . || true)"
  if [ "${n:-0}" -gt 1 ]; then
    { echo "wo: WO-$1 is ambiguous — $n folders carry that number:"
      printf '%s\n' "$hits" | sed 's|^|    |'
      echo "    Rename all but one (keep the number unique) before using WO-$1."
    } >&2
    return 0
  fi
  printf '%s\n' "$hits"
}

with_id_lock() { # <command...> — serialise identity allocation across processes
  # mkdir is atomic on every POSIX filesystem, which is the whole reason it is the
  # lock here: two drivers cannot both create the same directory.
  local lock="$WO_DIR/.acp-id.lock" waited=0 rc=0
  mkdir -p "$WO_DIR"
  while ! mkdir "$lock" 2>/dev/null; do
    # A lock nobody released belonged to a process that died holding it.
    if [ -n "$(find "$lock" -maxdepth 0 -mmin +2 2>/dev/null)" ]; then rm -rf "$lock" 2>/dev/null || true; continue; fi
    waited=$((waited + 1))
    [ "$waited" -gt 600 ] && die "another wo is holding the identity lock ($lock). Remove it if nothing else is running."
    sleep 0.1 2>/dev/null || sleep 1
  done
  # die() inside the protected section exits the script; the lock must not outlive it.
  trap 'rm -rf "$lock" 2>/dev/null || true' EXIT
  "$@" || rc=$?
  trap - EXIT
  rm -rf "$lock" 2>/dev/null || true
  return $rc
}

next_number() { # [series]
  local series="${1:-}" max=0 n
  for d in "$WO_DIR"/WO-*; do
    [ -d "$d" ] || continue
    n="$(basename "$d")"; n="${n#WO-}"; n="${n%%-*}"
    case "$n" in ''|*[!0-9]*) continue;; esac
    if [ -n "$series" ]; then
      [ "${n:0:${#series}}" = "$series" ] || continue
    fi
    [ "$((10#$n))" -gt "$max" ] && max="$((10#$n))"
  done
  if [ "$max" -eq 0 ] && [ -n "$series" ]; then
    printf '%04d' "$((10#$series))"
  else
    printf '%04d' "$((max + 1))"
  fi
}

render() { # template dest number title priority
  sed -e "s/WO-XXXX/WO-$3/g" \
      -e "s/\[Title\]/$4/g" \
      -e "s/YYYY-MM-DD/$(date +%F)/g" \
      -e "s/^\*\*Priority:\*\* .*/**Priority:** $5/" \
      "$1" > "$2"
}

delegation() { # area -> "primary|backup|validator"  (the orchestrator's table)
  case "$1" in
    backend)     echo "BACKEND|architect|project-validator-expert";;
    api)         echo "rest-expert|BACKEND|openapi-expert";;
    database|db) echo "DATA|BACKEND|database-validator-expert";;
    auth)        echo "jwt-expert|BACKEND|iam-rbac-expert";;
    rbac)        echo "iam-rbac-expert|jwt-expert|project-validator-expert";;
    frontend|ui) echo "UI|ux-ui-designer-expert|frontend-validator-expert";;
    styling)     echo "css-expert|UI|ux-ui-designer-expert";;
    testing)     echo "tdd-guide|e2e-runner|project-validator-expert";;
    cicd)        echo "github-actions-expert|docker-expert|project-validator-expert";;
    docker)      echo "docker-expert|github-actions-expert|project-validator-expert";;
    security)    echo "owasp-top10-expert|jwt-expert|project-validator-expert";;
    performance) echo "performance-optimizer|BACKEND|project-validator-expert";;
    docs)        echo "documentation-expert|developer-experience-writer|critical-reviewer";;
    analysis)    echo "repo-analyst|code-explorer|factuality-validator";;
    integration) echo "e2e-runner|BACKEND|project-validator-expert";;
    *) return 1;;
  esac
}
resolve_specialists() { # BACKEND / UI / DATA tokens -> the detected stack's agents
  local be ui da
  be="$("$PIPELINE_ROOT/bin/stack-specialist" backend "$PROJECT_ROOT" 2>/dev/null || echo rest-expert)"
  ui="$("$PIPELINE_ROOT/bin/stack-specialist" ui "$PROJECT_ROOT" 2>/dev/null || echo react-expert)"
  da="$("$PIPELINE_ROOT/bin/stack-specialist" data "$PROJECT_ROOT" 2>/dev/null || echo postgres-expert)"
  printf '%s' "$1" | sed -e "s/BACKEND/$be/g" -e "s/^UI|/$ui|/" -e "s/|UI|/|$ui|/" -e "s/|UI\$/|$ui/" -e "s/DATA/$da/g"
}

cmd_new() {
  local title="" series="" priority="P2" want_sdk=0 want_ui=0 size="standard" area="" paths=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --area)     area="$2"; shift 2;;
      --paths)    paths="$2"; shift 2;;
      --size)     size="$2"; shift 2;;
      --series)   series="$2"; shift 2;;
      --priority) priority="$2"; shift 2;;
      --sdk)      want_sdk=1; shift;;
      --ui)       want_ui=1; shift;;
      -*)         die "unknown flag $1";;
      *)          title="$1"; shift;;
    esac
  done
  case "$size" in trivial|small|standard|large) ;; *) die "size must be trivial, small, standard, or large";; esac
  local primary="" backup="" validator=""
  if [ -n "$area" ]; then
    local deleg; deleg="$(delegation "$area")" || die "unknown area '$area' — backend api database auth rbac frontend ui styling testing cicd docker security performance docs analysis integration"
    deleg="$(resolve_specialists "$deleg")"
    primary="${deleg%%|*}"; backup="$(printf '%s' "$deleg" | cut -d'|' -f2)"; validator="${deleg##*|}"
    case "$area" in ui|frontend) [ "$size" != trivial ] && want_ui=1;; esac
  fi
  [ -n "$title" ] || die 'usage: wo new "<title>" [--size S] [--series N] [--priority P0|P1|P2|P3] [--sdk] [--ui]'
  mkdir -p "$WO_DIR"
  # Choosing a number and taking it have to be one operation. Scanning first and
  # creating afterwards lets four simultaneous creators all read the same maximum
  # and all believe they own WO-0001.
  local num dir
  reserve_number() {
    num="$(next_number "$series")"
    dir="$WO_DIR/WO-$num-$(slugify "$title")"
    [ -e "$dir" ] && die "$dir already exists"
    [ -n "$(find "$WO_DIR" -maxdepth 1 -type d -name "WO-$num-*" -print -quit 2>/dev/null)" ] \
      && die "WO-$num was taken while this ran; try again"
    mkdir -p "$dir"
  }
  with_id_lock reserve_number

  printf 'size=%s\ntitle=%s\npriority=%s\ncreated=%s\nowner=%s\n' "$size" "$title" "$priority" "$(date +%F)" "$(git config user.name 2>/dev/null || whoami)" > "$dir/.wo-meta"
  [ -n "$area" ] && printf 'area=%s\nprimary=%s\nbackup=%s\nvalidator=%s\n' "$area" "$primary" "$backup" "$validator" >> "$dir/.wo-meta"
  # Evidence is bound to the source it ran against. In a monorepo "the source" is
  # the part this work order touches, or unrelated commits invalidate its evidence.
  [ -n "$paths" ] && printf 'paths=%s\n' "$paths" >> "$dir/.wo-meta"
  # Snapshot the tree now, so the work order can name its own changes at close
  # time with or without git. It lives in the folder, which the fingerprint skips.
  write_manifest "$dir/.wo-manifest" "$paths"
  for k in $(required_docs "$size"); do
    case "$k" in
      MAIN)               render "$TEMPLATES/WO-TEMPLATE-MAIN.md"               "$dir/WO-$num-$(slugify "$title").md" "$num" "$title" "$priority";;
      SPEC)               case "$area" in analysis|docs) render "$TEMPLATES/WO-TEMPLATE-SPEC-ANALYSIS.md" "$dir/WO-$num-SPEC.md" "$num" "$title" "$priority";;
                                           *) render "$TEMPLATES/WO-TEMPLATE-SPEC.md" "$dir/WO-$num-SPEC.md" "$num" "$title" "$priority";; esac;;
      CHECKLIST)          render "$TEMPLATES/WO-TEMPLATE-CHECKLIST.md"          "$dir/WO-$num-CHECKLIST.md"      "$num" "$title" "$priority";;
      TASK-BREAKDOWN)     render "$TEMPLATES/WO-TEMPLATE-TASK-BREAKDOWN.md"     "$dir/WO-$num-TASK-BREAKDOWN.md" "$num" "$title" "$priority";;
      Prompt)             render "$TEMPLATES/WO-TEMPLATE-PROMPT.md"             "$dir/WO-$num-Prompt.md"         "$num" "$title" "$priority";;
      REVIEW)             render "$TEMPLATES/WO-TEMPLATE-REVIEW.md"             "$dir/WO-$num-REVIEW.md"         "$num" "$title" "$priority";;
      sdk-implementation) render "$TEMPLATES/WO-TEMPLATE-SDK-IMPLEMENTATION.md" "$dir/WO-$num-sdk-implementation.md" "$num" "$title" "$priority";;
      ui-implementation)  render "$TEMPLATES/WO-TEMPLATE-UI-IMPLEMENTATION.md"  "$dir/WO-$num-ui-implementation.md"  "$num" "$title" "$priority";;
    esac
  done
  [ "$want_sdk" -eq 1 ] && [ ! -f "$dir/WO-$num-sdk-implementation.md" ] && render "$TEMPLATES/WO-TEMPLATE-SDK-IMPLEMENTATION.md" "$dir/WO-$num-sdk-implementation.md" "$num" "$title" "$priority"
  [ "$want_ui"  -eq 1 ] && [ ! -f "$dir/WO-$num-ui-implementation.md" ]  && render "$TEMPLATES/WO-TEMPLATE-UI-IMPLEMENTATION.md"  "$dir/WO-$num-ui-implementation.md"  "$num" "$title" "$priority"

  if [ -n "$area" ]; then
    local pd; pd="$(primary_doc "$dir" "$num")"
    [ -n "$pd" ] && AREA="$area" PRIMARY="$primary" BACKUP="$backup" VALIDATOR="$validator" DOC="$pd" python3 - <<'PYEOF'
import os, pathlib
p = pathlib.Path(os.environ["DOC"]); s = p.read_text()
block = "\n> **Area:** %s  \n> **Implement with:** %s  \n> **Backup:** %s  \n> **Validate with:** %s (never the agent that implemented)\n" % (os.environ["AREA"], os.environ["PRIMARY"], os.environ["BACKUP"], os.environ["VALIDATOR"])
first, rest = (s.split("\n", 1) + [""])[:2]
p.write_text(first + "\n" + block + "\n" + rest)
PYEOF
  fi
  [ -n "$area" ] && write_specialists "$dir" "$num" "$primary" "$backup" "$validator"
  echo "WO-$num created ($size): $dir"
  ls "$dir" | sed 's/^/    /'
  if [ -n "$area" ]; then echo; echo "Delegation ($area):"; echo "  implement with : $primary"; echo "  backup         : $backup"; echo "  validate with  : $validator"; fi
  echo
  case "$area" in analysis|docs) echo "Next: fill in the SPEC (target, questions, deliverables) before reading the target. Closeout is blocked until";;
    *) echo "Next: fill in the SPEC before writing code. Closeout is blocked until";; esac
  echo "      WO-$num-VERIFICATION.md exists with real execution evidence."
}

doc_state() { # dir number -> prints markers
  local d="$1" n="$2" out=""
  for k in SPEC CHECKLIST TASK-BREAKDOWN Prompt VERIFICATION CLOSEOUT; do
    if ls "$d" 2>/dev/null | grep -qi -- "WO-$n-$k"; then out="$out${k:0:1}"; else out="$out."; fi
  done
  echo "$out"
}

evidence_summary() { # dir number -> PASS 42/43 | FAIL 12/15 | PRECOND | PLAN | RUNNING | -
  local v="$1/WO-$2-VERIFICATION.md"; [ -f "$v" ] || { echo "-"; return; }
  local st; st="$(latest_status "$v")"
  local ratio; ratio="$(grep -m1 -oE 'checks [0-9]+/[0-9]+' "$v" | cut -d' ' -f2 || true)"
  case "$st" in none) echo "-";; *) echo "$st${ratio:+ $ratio}";; esac
}
cmd_list() {
  local filter="${1:-}"
  printf "%-8s %-6s %-12s %-8s %-14s %s\n" "WO" "DOCS" "STATE" "SIZE" "EVIDENCE" "TITLE"
  for d in "$WO_DIR"/WO-*; do
    [ -d "$d" ] || continue
    local b n st state size
    b="$(basename "$d")"; n="${b#WO-}"; n="${n%%-*}"
    st="$(doc_state "$d" "$n")"; size="$(meta_get "$d" size)"; size="${size:-standard}"
    state="$(wo_state "$d" "$n")"
    case "$filter" in
      --open)   [ "$state" = "open" ]   || continue;;
      --active) [ "$state" != "closed" ] && [ "$state" != "migrated" ] || continue;;
      --closed) [ "$state" = "closed" ] || continue;;
      --adopted|--migrated) [ "$state" = "migrated" ] || continue;;
    esac
    printf "%-8s %-6s %-12s %-8s %-14s %s\n" "WO-$n" "$st" "$state" "$size" "$(evidence_summary "$d" "$n")" "${b#WO-$n-}"
  done
}

cmd_adopt() { # <file> --number N [--title T] [--status migrated] [--opened YYYY-MM-DD] [--size small] [--dry-run]
  # A project older than a week arrives with a record. That record is history: it
  # says what was done, and it cannot say what the tests prove today, because they
  # did not run under this tool. So an adopted item keeps its document, gets a
  # number, and gets no verification. Nothing here can be mistaken for evidence.
  local file="" num="" title="" status="migrated" opened="" size="small" dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --number) num="$2"; shift 2;;
      --title)  title="$2"; shift 2;;
      --status) status="$2"; shift 2;;
      --opened) opened="$2"; shift 2;;
      --size)   size="$2"; shift 2;;
      --dry-run) dry=1; shift;;
      -*) die "unknown flag $1";;
      *) file="$1"; shift;;
    esac
  done
  [ -n "$file" ] && [ -f "$file" ] || die 'usage: wo adopt <file.md> --number N [--title T] [--status migrated|open] [--opened YYYY-MM-DD] [--size small] [--dry-run]'
  [ -n "$num" ] || die "wo adopt: --number is required; adopted work keeps the number its record already cites"
  num="$(printf '%04d' "$((10#$num))")"
  case "$size" in trivial|small|standard|large) ;; *) die "size must be trivial, small, standard, or large";; esac
  case "$status" in migrated|adopted|open|in-progress|blocked) ;; *) die "status must be migrated, adopted, open, in-progress, or blocked";; esac
  [ -z "$title" ] && title="$(grep -m1 -E '^# ' "$file" | sed 's/^# *//' | cut -c1-80)"
  [ -z "$title" ] && { title="$(basename "$file" .md)"; }
  # A record that already sits in a WO-N folder under the work-order directory is
  # adopted where it is: the folder keeps its name and contents, and only the
  # metadata that makes it the pipeline's is added.
  local fdir; fdir="$(cd "$(dirname "$file")" && pwd -P)"
  case "$fdir" in "$WO_DIR"/WO-"$num"-*)
    [ -f "$fdir/.wo-meta" ] && die "WO-$num is already the pipeline's (it carries .wo-meta)"
    if [ "$dry" -eq 1 ]; then printf 'would adopt in place  %s\n             status  %s   size %s\n' "${fdir#$PROJECT_ROOT/}" "$status" "$size"; return 0; fi
    printf 'size=%s\ntitle=%s\npriority=P2\ncreated=%s\nadopted=%s\nadopted_from=%s\nowner=%s\nstatus=%s\n' \
      "$size" "$title" "${opened:-$(date +%F)}" "$(date +%F)" "$file" "$(git config user.name 2>/dev/null || whoami)" "$status" > "$fdir/.wo-meta"
    echo "WO-$num adopted in place ($status): ${fdir#$PROJECT_ROOT/}"
    echo "No verification was written. Adopted work is recorded, not verified."
    return 0;;
  esac
  local taken; taken="$(find "$WO_DIR" -maxdepth 1 -type d -name "WO-$num-*" -print -quit 2>/dev/null)"
  [ -z "$taken" ] || die "WO-$num already exists: $taken. Two records cannot share a number. To adopt that folder as it is, name a file inside it."
  local dir="$WO_DIR/WO-$num-$(slugify "$title")" doc
  case "$size" in trivial) doc="$dir/WO-$num-$(slugify "$title").md";; *) doc="$dir/WO-$num-SPEC.md";; esac
  if [ "$dry" -eq 1 ]; then
    printf 'would adopt  %s\n         as  %s\n     status  %s   size %s   opened %s\n' "$file" "${doc#$PROJECT_ROOT/}" "$status" "$size" "${opened:-$(date +%F)}"
    return 0
  fi
  mkdir -p "$WO_DIR"
  reserve_number() { [ -e "$dir" ] && die "$dir already exists"; mkdir -p "$dir"; }
  with_id_lock reserve_number
  cp "$file" "$doc"
  printf 'size=%s\ntitle=%s\npriority=P2\ncreated=%s\nadopted=%s\nadopted_from=%s\nowner=%s\nstatus=%s\n' \
    "$size" "$title" "${opened:-$(date +%F)}" "$(date +%F)" "$file" "$(git config user.name 2>/dev/null || whoami)" "$status" > "$dir/.wo-meta"
  echo "WO-$num adopted ($status): ${dir#$PROJECT_ROOT/}"
  echo "    ${doc#$dir/}   (the original record, unchanged)"
  echo "No verification was written. Adopted work is recorded, not verified: when the work is"
  echo "exercised again, run its suite with  wo verify $num --run <suite.sh>  and the record becomes evidence."
}

cmd_route() { # area -> who is routed, and where their definitions are
  local area="${1:-}"; [ -n "$area" ] || die "usage: wo route <area>"
  local deleg; deleg="$(delegation "$area")" || die "unknown area '$area'"
  deleg="$(resolve_specialists "$deleg")"
  local role name f
  for role in "implement:${deleg%%|*}" "backup:$(printf '%s' "$deleg" | cut -d'|' -f2)" "validate:${deleg##*|}"; do
    name="${role#*:}"; f="$(agent_file "$name")"
    printf '  %-10s %-32s %s\n' "${role%%:*}" "$name" "${f:+${f#$PROJECT_ROOT/}}"
  done
}

cmd_status() {
  local n="$1"; [ -n "$n" ] || die "usage: wo status <number>"
  local d; d="$(wo_folder "$n")"; [ -n "$d" ] || die "no work order WO-$n under $WO_DIR"
  echo "WO-$n  $d"
  echo
  local missing=0 size; size="$(meta_get "$d" size)"; size="${size:-standard}"
  echo "  size: $size"
  for k in $(required_docs "$size"); do
    if has_doc "$d" "$n" "$k"; then echo "  [x] $k (required)"; else echo "  [ ] $k (required) — MISSING"; missing=1; fi
  done
  for k in VERIFICATION CLOSEOUT; do
    has_doc "$d" "$n" "$k" && echo "  [x] $k" || echo "  [ ] $k"
  done
  echo
  [ "$missing" -eq 1 ] && echo "  INCOMPLETE — required documents are missing." || echo "  Required documents present."
}

cmd_close() {
  local n="$1"; [ -n "$n" ] || die "usage: wo close <number>"
  local d; d="$(wo_folder "$n")"; [ -n "$d" ] || die "no work order WO-$n under $WO_DIR"
  export WO_PATHS; WO_PATHS="$(meta_get "$d" paths)"
  ls "$d" | grep -qi -- "WO-$n-VERIFICATION" \
    || die "refusing to close WO-$n: no WO-$n-VERIFICATION.md.
    The methodology forbids a closeout without executed-test evidence.
    Create it by running the suite:  wo verify $n --run <suite.sh>"
  local vfile="$d/WO-$n-VERIFICATION.md"
  case "$(latest_status "$vfile")" in
    PASS) ;;
    FAIL) die "refusing to close WO-$n: the latest verification run is EXECUTED — FAIL. Fix the work, re-run:  wo verify $n --run <suite.sh>";;
    RUNNING) die "refusing to close WO-$n: the last verification never finished. It was interrupted, and an interrupted run is not a result — whatever passed before it says nothing about now. Run it again:  wo verify $n --run <suite.sh>";;
    PRECOND) die "refusing to close WO-$n: the last verification could not run (exit 77: a precondition failed). Nothing was asserted, so there is no result to close on. Fix the environment and run it again:  wo verify $n --run <suite.sh>";;
    *) die "refusing to close WO-$n: verification is NOT EXECUTED — PLAN ONLY. A plan is not evidence. Run it:  wo verify $n --run <suite.sh>";;
  esac
  local area; area="$(meta_get "$d" area)"
  local ph budget; ph="$(unfilled_placeholders "$vfile")"; budget="$(placeholder_budget "$(vtemplate "$area" "$(meta_get "$d" intake)")")"
  if [ "${ph:-0}" -gt "$budget" ] && [ "${ALLOW_PLACEHOLDERS:-0}" != 1 ]; then
    die "refusing to close WO-$n: the verification document still carries $ph of its template placeholders (at most $budget may remain).
    A document nobody filled in reads as evidence and is not. Replace the narrative
    sections with what actually ran, or pass ALLOW_PLACEHOLDERS=1 if they are genuinely N/A."
  fi
  local recorded; recorded="$(grep -m1 -oE 'tree [0-9a-f]{16}' "$vfile" | cut -d' ' -f2 || true)"
  if [ -n "$recorded" ] && [ "${ALLOW_STALE:-0}" != 1 ] && [ "$recorded" != "$(tree_fingerprint)" ]; then
    die "refusing to close WO-$n: the source changed after the last PASS (tree $recorded then, $(tree_fingerprint) now).
    Evidence is bound to the source it ran against. Re-run:  wo verify $n --run <suite.sh>   (ALLOW_STALE=1 to override)
    Committing does not change the fingerprint; editing, formatting, or a teammate's change inside the tree does."
  fi
  # The suite that produced the pass is bound too: it lives outside the tree
  # fingerprint so that writing the next suite does not stale this one, which
  # means its own changes have to be checked here.
  local sref; sref="$(grep -m1 -oE 'suite [^ )]+@[0-9a-f]{16}' "$vfile" | cut -d' ' -f2 || true)"
  if [ -n "$sref" ] && [ "${ALLOW_STALE:-0}" != 1 ]; then
    local spath="${sref%@*}" shash="${sref#*@}"
    if [ -f "$PROJECT_ROOT/$spath" ] && [ "$(suite_fingerprint "$PROJECT_ROOT/$spath")" != "$shash" ]; then
      die "refusing to close WO-$n: the suite that produced the PASS has changed since it ran ($spath).
    A changed test says nothing about whether the old one still passes. Re-run:  wo verify $n --run $spath   (ALLOW_STALE=1 to override)"
    fi
  fi
  # Standard and large work orders are reviewed by someone who did not write them.
  # That step is where a second pair of eyes finds what the first could no longer
  # see, and it is the one part of the method a single agent will skip if allowed.
  local size; size="$(meta_get "$d" size)"; size="${size:-standard}"
  case "$size" in standard|large)
    if [ "${ACP_SKIP_REVIEW:-0}" != 1 ]; then
      local rv; rv="$(ls "$d" 2>/dev/null | grep -i -- "^WO-$n-\(INDEPENDENT-\)\{0,1\}REVIEW\.md$" | head -1 || true)"
      [ -n "$rv" ] || die "refusing to close WO-$n: no independent review on file (WO-$n-REVIEW.md).
    A $size work order is reviewed by an agent that did not implement it, in the validator role named
    in the work order. Write the review, or ACP_SKIP_REVIEW=1 with a reason in the closeout."
      local rph rbudget; rph="$(unfilled_placeholders "$d/$rv")"; rbudget="$(placeholder_budget "$TEMPLATES/WO-TEMPLATE-REVIEW.md")"
      [ "${rph:-0}" -le "$rbudget" ] || die "refusing to close WO-$n: $rv is still the template ($rph placeholders remain, at most $rbudget may).
    A review nobody wrote is not a review. Fill it in, or ACP_SKIP_REVIEW=1 with a reason in the closeout."
    fi;;
  esac
  # The rules, over what this work order changed. Under Claude Code the session hooks
  # already said most of this as it happened; here it is said again where it counts,
  # and under any other tool this is the first time it is said at all.
  if [ -f "$CHECK" ] && [ "${ACP_SKIP_CHECK:-0}" != 1 ]; then
    local crc=0 conly=()
    [ -n "${WO_PATHS:-}" ] && IFS=, read -r -a conly <<< "$WO_PATHS"
    if [ -f "$d/.wo-manifest" ]; then
      ( cd "$PROJECT_ROOT" && python3 "$CHECK" --root "$PROJECT_ROOT" --manifest "$d/.wo-manifest" --exclude $(fingerprint_excludes | tr '\n' ' ') --no-kb ${conly[@]:+--only "${conly[@]}"} ) || crc=$?
    elif ( cd "$PROJECT_ROOT" && git rev-parse --show-toplevel >/dev/null 2>&1 ); then
      ( cd "$PROJECT_ROOT" && python3 "$CHECK" --root "$PROJECT_ROOT" --since HEAD ) || crc=$?
    else
      echo "wo: WO-$n predates the manifest and there is no git; the close-time checks were not run" >&2
    fi
    [ "$crc" -ne 2 ] || die "refusing to close WO-$n: the checks above block. Fix them, or ACP_SKIP_CHECK=1 with a reason in the closeout."
  fi
  # The knowledge base describes the code. A change to code a profile cites makes
  # that profile a claim about something that no longer exists; the tool cannot
  # rewrite it, but it can say so here, where the work is still in mind.
  KB_IMPACT=""
  local kbd="$PROJECT_ROOT/${KNOWLEDGE_DIR:-Workspace/Docs/KnowledgeBase}" kbpy="$PIPELINE_ROOT/core/hooks/kb.py"
  if [ -d "$kbd" ] && [ -f "$kbpy" ] && [ -f "$d/.wo-manifest" ] && [ -f "$CHECK" ]; then
    local changed; changed="$(cd "$PROJECT_ROOT" && python3 "$CHECK" --root "$PROJECT_ROOT" --manifest "$d/.wo-manifest" --exclude $(fingerprint_excludes | tr '\n' ' ') --list 2>/dev/null || true)"
    if [ -n "$changed" ]; then
      local irc=0; KB_IMPACT="$(printf '%s\n' "$changed" | python3 "$kbpy" impact --root "$PROJECT_ROOT" --kb "$kbd" --stdin 2>/dev/null)" || irc=$?
      if [ "$irc" -eq 1 ]; then
        echo "Knowledge base: this work order changed files that these profiles describe:" >&2
        printf '%s\n' "$KB_IMPACT" | sed 's/^/    /' >&2
        if [ "${ACP_STRICT:-0}" = 1 ] && [ "${ACP_SKIP_KB:-0}" != 1 ]; then
          die "refusing to close WO-$n under the strict profile: update the profiles above, then  acp kb bind   (ACP_SKIP_KB=1 to override)"
        fi
        echo "    Update them before the next reader trusts them, then:  acp kb bind" >&2
      fi
    fi
  fi
  local out="$d/WO-$n-CLOSEOUT.md"
  [ -e "$out" ] && die "$out already exists"
  local title; title="$(basename "$d")"; title="${title#WO-$n-}"
  render "$(ctemplate "$area")" "$out" "$n" "$title" "P2"
  if [ -n "${KB_IMPACT:-}" ]; then
    { printf '\n## Knowledge Base Impact\n\nThis work order changed files the following profiles describe. They were recorded here at close; a profile that still describes the old code is a claim about something that no longer exists.\n\n```\n%s\n```\n' "$KB_IMPACT"; } >> "$out"
  fi
  echo "WO-$n closeout drafted: $out"
  echo "Fill it in from the verification report — do not claim results that were not executed."
  echo "When it is worth carrying to the next project:  wo promote $n"
  local inum; inum="$(meta_get "$d" issue_number)"
  if [ -n "$inum" ] && command -v gh >/dev/null 2>&1; then
    REPO="$(gh_repo)"; [ -n "$REPO" ] && gh issue close "$inum" --repo "$REPO" --comment "Closed with executed verification. Closeout: \`$(basename "$out")\` in the repository." >/dev/null 2>&1 && echo "Issue #$inum closed."
  fi
}

gh_repo() { # -> owner/name or empty
  if [ -n "${GITHUB_REPO:-}" ] && [ "$GITHUB_REPO" != "owner/repo" ]; then echo "$GITHUB_REPO"; return; fi
  ( cd "$PROJECT_ROOT" && gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null ) || true
}
gh_ready() {
  command -v gh >/dev/null 2>&1 || die "the gh CLI is required for GitHub commands (https://cli.github.com), and must be authenticated: gh auth login"
  REPO="$(gh_repo)"; [ -n "$REPO" ] || die "no GitHub repository: set GITHUB_REPO in pipeline.config.sh or run inside a repo with a GitHub remote"
}
gh_labels() { # ensure the labels exist (idempotent)
  for l in "work-order:#0E8A16" "bug:#D73A4A" "size:trivial:#C5DEF5" "size:small:#C5DEF5" "size:standard:#C5DEF5" "size:large:#C5DEF5" "P0:#B60205" "P1:#D93F0B" "P2:#FBCA04" "P3:#0E8A16"; do
    gh label create "${l%%:#*}" --color "${l##*#}" --repo "$REPO" --force >/dev/null 2>&1 || true
  done
}
issue_body() { # dir number -> markdown body for the issue
  local d="$1" n="$2" pd; pd="$(primary_doc "$d" "$n")"
  {
    printf '<!-- AICodePipeline work order WO-%s — the folder in the repository is the record; this issue is the shared view. -->\n\n' "$n"
    printf '**Work order:** `WO-%s`  \n**Size:** %s  \n**Priority:** %s  \n**Owner:** %s  \n**Documents:** `%s`\n\n---\n\n' \
      "$n" "$(meta_get "$d" size)" "$(meta_get "$d" priority)" "$(meta_get "$d" owner)" "$(doc_state "$d" "$n")"
    [ -n "$pd" ] && cat "$pd"
  }
}

cmd_publish() {
  local n="${1:-}"; [ -n "$n" ] || die "usage: wo publish <number>"
  local d; d="$(wo_folder "$n")"; [ -n "$d" ] || die "no work order WO-$n"
  gh_ready
  local existing; existing="$(meta_get "$d" issue)"
  [ -n "$existing" ] && die "WO-$n is already published: $existing  (use: wo sync $n)"
  gh_labels
  local title size prio body url num
  title="$(meta_get "$d" title)"; title="${title:-$(basename "$d")}"; size="$(meta_get "$d" size)"; prio="$(meta_get "$d" priority)"
  body="$(mktemp)"; issue_body "$d" "$n" > "$body"
  url="$(gh issue create --repo "$REPO" --title "WO-$n: $title" --body-file "$body" --label work-order --label "size:${size:-standard}" ${prio:+--label "$prio"} 2>&1 | tail -1)"
  rm -f "$body"
  case "$url" in https://*) ;; *) die "gh issue create failed: $url";; esac
  num="${url##*/}"
  meta_set "$d" issue "$url"; meta_set "$d" issue_number "$num"
  cmd_note "$n" "Published as $url" >/dev/null
  echo "WO-$n published: $url"
}

cmd_sync() {
  local n="${1:-}"; [ -n "$n" ] || die "usage: wo sync <number>"
  local d; d="$(wo_folder "$n")"; [ -n "$d" ] || die "no work order WO-$n"
  gh_ready
  local num; num="$(meta_get "$d" issue_number)"; [ -n "$num" ] || die "WO-$n is not published (wo publish $n)"
  local body; body="$(mktemp)"; issue_body "$d" "$n" > "$body"
  gh issue edit "$num" --repo "$REPO" --body-file "$body" >/dev/null
  rm -f "$body"
  local st status; st="$(doc_state "$d" "$n")"; status="$(meta_get "$d" status)"; status="${status:-open}"
  gh issue comment "$num" --repo "$REPO" --body "$(printf 'Sync %s — status **%s**, documents `%s`%s' "$(date '+%Y-%m-%d %H:%M')" "$status" "$st" "$( [ "$status" = blocked ] && printf ', blocked: %s' "$(meta_get "$d" blocked_reason)" )")" >/dev/null
  echo "WO-$n synced to issue #$num"
}

cmd_import() {
  local num="${1:-}"; [ -n "$num" ] || die "usage: wo import <issue-number> [--size S]"
  shift; local size="standard"; while [ $# -gt 0 ]; do case "$1" in --size) size="$2"; shift 2;; *) shift;; esac; done
  gh_ready
  local title body url
  title="$(gh issue view "$num" --repo "$REPO" --json title -q .title)"; [ -n "$title" ] || die "issue #$num not found in $REPO"
  body="$(gh issue view "$num" --repo "$REPO" --json body -q .body)"; url="$(gh issue view "$num" --repo "$REPO" --json url -q .url)"
  title="${title#WO-[0-9]*: }"
  cmd_new "$title" --size "$size" --series "$num" | head -1
  local d; d="$(wo_folder "$(printf '%04d' "$((10#$num))")")"
  [ -n "$d" ] || die "import created no folder"
  meta_set "$d" issue "$url"; meta_set "$d" issue_number "$num"
  local pd; pd="$(primary_doc "$d" "$(printf '%04d' "$((10#$num))")")"
  [ -n "$body" ] && printf '\n---\n\n## From issue #%s\n\n%s\n' "$num" "$body" >> "$pd"
  echo "Imported issue #$num as $(basename "$d") (numbered from the issue so the two match)"
}

cmd_show() {
  local n="${1:-}"; [ -n "$n" ] || die "usage: wo show <number>"
  local d; d="$(wo_folder "$n")"; [ -n "$d" ] || die "no work order WO-$n under $WO_DIR"
  [ -f "$d/.wo-meta" ] && { sed 's/^/  /' "$d/.wo-meta"; echo; }
  local pd; pd="$(primary_doc "$d" "$n")"; [ -n "$pd" ] && cat "$pd" || echo "(no primary document)"
}

cmd_start() {
  local n="${1:-}"; [ -n "$n" ] || die "usage: wo start <number>"
  local d; d="$(wo_folder "$n")"; [ -n "$d" ] || die "no work order WO-$n"
  meta_set "$d" status in-progress; meta_set "$d" started "$(date +%F)"; meta_set "$d" blocked_reason ""
  echo "WO-$n: in progress (started $(date +%F))"
}

cmd_block() {
  local n="${1:-}" reason="${2:-}"; [ -n "$n" ] && [ -n "$reason" ] || die 'usage: wo block <number> "<reason>"'
  local d; d="$(wo_folder "$n")"; [ -n "$d" ] || die "no work order WO-$n"
  meta_set "$d" status blocked; meta_set "$d" blocked_reason "$reason"
  cmd_note "$n" "BLOCKED: $reason" >/dev/null
  echo "WO-$n: blocked — $reason"
}

cmd_note() {
  local n="${1:-}" text="${2:-}"; [ -n "$n" ] && [ -n "$text" ] || die 'usage: wo note <number> "<text>"'
  local d; d="$(wo_folder "$n")"; [ -n "$d" ] || die "no work order WO-$n"
  local pd; pd="$(primary_doc "$d" "$n")"; [ -n "$pd" ] || die "WO-$n has no primary document to note in"
  grep -q '^## Session Notes' "$pd" || printf '\n---\n\n## Session Notes\n\n' >> "$pd"
  printf -- '- %s — %s\n' "$(date '+%Y-%m-%d %H:%M')" "$text" >> "$pd"
  echo "WO-$n: note added to $(basename "$pd")"
}

unfilled_placeholders() { # file -> how many template placeholders were never replaced
  local f="$1"; [ -f "$f" ] || { echo 0; return; }
  # Square-bracket prompts the templates ship with, outside code blocks and the
  # driver's own Execution Record. A document still full of them looks complete
  # and says nothing.
  awk 'BEGIN{c=0;code=0} /^```/{code=!code;next} code{next} /^## Execution Record/{stop=1} stop{next}
       {n=gsub(/\[[A-Za-z][^]]{2,}\]/,""); c+=n} END{print c}' "$f"
}

CHECK="$PIPELINE_ROOT/core/hooks/check.py"
fingerprint_excludes() { # the folders whose contents are never "the source"
  printf '%s\n' "$WORKORDERS_DIR" "${BUGS_DIR:-Workspace/Docs/Bugs}" "${SESSIONS_DIR:-Workspace/Sessions}" "${PIPELINE_ROOT#$PROJECT_ROOT/}" "${TESTING_DIR:-Workspace/Testing}/results" "${TESTING_DIR:-Workspace/Testing}/suites" "${KNOWLEDGE_DIR:-Workspace/Docs/KnowledgeBase}"
}
write_manifest() { # <file> [paths csv]
  [ -f "$CHECK" ] || return 0
  local only=(); [ -n "${2:-}" ] && IFS=, read -r -a only <<< "$2"
  ( cd "$PROJECT_ROOT" && python3 "$CHECK" --root "$PROJECT_ROOT" --write-manifest "$1" --exclude $(fingerprint_excludes | tr '\n' ' ') ${only[@]:+--only "${only[@]}"} ) 2>/dev/null || true
}
agent_file() { # name -> path of the specialist's definition, wherever this layout keeps it
  local n="$1" c
  for c in "$PROJECT_ROOT/.claude/agents/$n.md" "$PIPELINE_ROOT/core/agents/base/$n.md" "$PIPELINE_ROOT/core/agents/roles/$n.md" "$PIPELINE_ROOT/core/agents/domain/$n.md" "$PIPELINE_ROOT/agents/$n.md"; do
    [ -f "$c" ] && { echo "$c"; return; }
  done
}
write_specialists() { # dir number primary backup validator
  # The routing names the specialists; this puts them where every tool will look.
  # A name in metadata is used by nothing. Guidance in the work order is read by
  # whatever agent does the work, under Claude Code or anything else.
  local dir="$1" num="$2" doc; doc="$dir/WO-$num-Prompt.md"; [ -f "$doc" ] || doc="$(primary_doc "$dir" "$num")"; [ -n "$doc" ] || return 0
  {
    echo; echo "---"; echo; echo "## Specialists for this work order"; echo
    echo "The roles below were routed for this area. Read each one before starting the part it covers;"
    echo "under Claude Code, delegate that part to the named subagent. Under any other tool, the file"
    echo "is the specialist: read it and work as it says. \`acp agent <name>\` prints any of them."; echo
    local role name f desc
    for role in "implement:$3" "backup:$4" "validate:$5"; do
      name="${role#*:}"; [ -n "$name" ] || continue
      f="$(agent_file "$name")"
      if [ -n "$f" ]; then
        desc="$(sed -n 's/^description: *//p' "$f" | head -1 | cut -c1-220)"
        printf -- '- **%s:** `%s` — %s  \n  Definition: `%s`\n' "${role%%:*}" "$name" "${desc:-see the definition}" "${f#$PROJECT_ROOT/}"
      else
        printf -- '- **%s:** `%s` — no definition installed for this name; work in that role as best you can.\n' "${role%%:*}" "$name"
      fi
    done
    echo; echo "The validator is never the agent that implemented. Its findings go in WO-$num-REVIEW.md, and"
    echo "for standard and large work orders close refuses without that document filled in."
  } >> "$doc"
}

placeholder_budget() { # [template] how many template prompts may still remain at close
  # Half of what the template itself ships with. Calibrating against the template
  # keeps the gate proportionate when the template grows or shrinks, and asks for
  # substantive filling rather than an exhausting sweep of every prose prompt.
  local t="${1:-$TESTING_TEMPLATES/TEST-TEMPLATE-VERIFICATION.md}" base
  if [ -f "$t" ]; then base="$(unfilled_placeholders "$t")"; echo "$((base / 2))"; else echo 24; fi
}

latest_status() { # verification file -> PASS | FAIL | PLAN | none  (the Overall status line is authoritative; older run records are history)
  local f="$1"; [ -f "$f" ] || { echo none; return; }
  local line; line="$(grep -m1 -E '^\*\*Overall status:\*\*' "$f" || true)"
  case "$line" in
    *RUNNING*) echo RUNNING;;
    *"EXECUTED — PASS"*|*"EXECUTED - PASS"*) echo PASS;;
    *"EXECUTED — FAIL"*|*"EXECUTED - FAIL"*) echo FAIL;;
    *PRECONDITION*) echo PRECOND;;
    *"NOT EXECUTED"*) echo PLAN;;
    *) echo none;;
  esac
}
tree_fingerprint() { # hash of the source state the evidence was produced against; the work-order, bug, session, results, suites, and pipeline folders are excluded
  ( set +e; cd "$PROJECT_ROOT" 2>/dev/null || { echo nofp; exit 0; }
    local tdir="${TESTING_DIR:-Workspace/Testing}"
    local ex=(":!$WORKORDERS_DIR" ":!${BUGS_DIR:-Workspace/Docs/Bugs}" ":!${SESSIONS_DIR:-Workspace/Sessions}" ":!${PIPELINE_ROOT#$PROJECT_ROOT/}" ":!$tdir/results" ":!$tdir/suites" ":!${KNOWLEDGE_DIR:-Workspace/Docs/KnowledgeBase}")
    # WO_PATHS narrows "the source" to what the work order declared (wo new --paths)
    local scope=(.); [ -n "${WO_PATHS:-}" ] && IFS=, read -r -a scope <<< "$WO_PATHS"
    if git rev-parse --show-toplevel >/dev/null 2>&1; then
      # Every file contributes the same way whether git tracks it yet or not: its
      # path and a hash of its content. Hashing index entries for tracked files and
      # raw bytes for untracked ones meant `git add` changed the fingerprint of a
      # file whose content had not changed, so committing the work staled the
      # evidence just produced. One hash-object process reads every path at once.
      local list; list="$(mktemp)"
      { git -c core.quotePath=false ls-files -- "${scope[@]}" "${ex[@]}"
        git -c core.quotePath=false ls-files -o --exclude-standard -- "${scope[@]}" "${ex[@]}"; } 2>/dev/null \
        | LC_ALL=C sort -u | while IFS= read -r f; do [ -f "$f" ] && printf '%s\n' "$f"; done > "$list"
      paste -d' ' <(git hash-object --stdin-paths < "$list" 2>/dev/null) "$list"
      rm -f "$list"
    else
      find "${scope[@]}" -type f -not -path './.git/*' -not -path "./$WORKORDERS_DIR/*" -not -path "./${BUGS_DIR:-Workspace/Docs/Bugs}/*" -not -path "./${SESSIONS_DIR:-Workspace/Sessions}/*" \
           -not -path "./${PIPELINE_ROOT#$PROJECT_ROOT/}/*" -not -path "./$tdir/results/*" -not -path "./$tdir/suites/*" -not -path "./${KNOWLEDGE_DIR:-Workspace/Docs/KnowledgeBase}/*" -not -path '*/node_modules/*' -not -path '*/.venv/*' -not -path '*/dist/*' 2>/dev/null \
        | LC_ALL=C sort | while IFS= read -r f; do printf '%s\n' "$f"; cat "$f" 2>/dev/null; done
    fi | { shasum -a 256 2>/dev/null || sha256sum; } | cut -c1-16
    true )
}
suite_fingerprint() { # suite file -> hash of the suite that produced the evidence
  [ -f "$1" ] && { shasum -a 256 2>/dev/null || sha256sum; } < "$1" | cut -c1-16 || echo none
}
check_counts() { # log -> "passed failed" from the last summary line a runner printed; nothing if none
  perl -ne '
    if    (/([0-9]+)[ \t]+passed(?![A-Za-z]).*?([0-9]+)[ \t]+failed(?![A-Za-z])/i)      { $p=$1; $f=$2 }
    elsif (/([0-9]+)[ \t]+failed(?![A-Za-z]).*?([0-9]+)[ \t]+passed(?![A-Za-z])/i)      { $f=$1; $p=$2 }
    elsif (/Tests:[ \t]+(?:([0-9]+)[ \t]+failed,[ \t]+)?([0-9]+)[ \t]+passed/i)        { $f=($1||0); $p=$2 }
    elsif (/^[ \t]*([0-9]+)[ \t]+passing(?![A-Za-z])/i)                                 { $p=$1; $f=0 unless defined $f }
    elsif (/^[ \t]*([0-9]+)[ \t]+failing(?![A-Za-z])/i)                                 { $f=$1 }
    elsif (/^[ \t]*([0-9]+)[ \t]+passed(?![A-Za-z])(?!.*failed)/i)                      { $p=$1; $f=0 }
    END { print +(defined $p ? $p : 0), " ", (defined $f ? $f : 0), "\n" if defined $p or defined $f }' "$1" 2>/dev/null
}
wo_state() { # dir number -> closed | open | in-progress | blocked | migrated | ...
  # One definition, used by list and stats alike: a closeout on file means closed;
  # otherwise the recorded status; otherwise open.
  if ls "$1" 2>/dev/null | grep -qi -- "WO-$2-CLOSEOUT"; then echo closed; return; fi
  local st; st="$(meta_get "$1" status)"; echo "${st:-open}"
}
vtemplate() { # area [intake-step] -> the verification template that fits the work
  # An intake step's verification is the shipped suite and nothing else; the
  # feature-work template's fifty prompts would only ever be crossed out.
  if [ -n "${2:-}" ] && [ -f "$PIPELINE_ROOT/core/templates/intake/TEST-TEMPLATE-VERIFICATION-INTAKE.md" ]; then
    echo "$PIPELINE_ROOT/core/templates/intake/TEST-TEMPLATE-VERIFICATION-INTAKE.md"; return
  fi
  case "${1:-}" in ui|frontend|styling)
    [ -f "$TESTING_TEMPLATES/TEST-TEMPLATE-VERIFICATION-UI.md" ] && { echo "$TESTING_TEMPLATES/TEST-TEMPLATE-VERIFICATION-UI.md"; return; };;
  esac
  echo "$TESTING_TEMPLATES/TEST-TEMPLATE-VERIFICATION.md"
}
ctemplate() { # area -> the closeout template that fits the work
  case "${1:-}" in ui|frontend|styling)
    [ -f "$TEMPLATES/WO-TEMPLATE-CLOSEOUT-UI.md" ] && { echo "$TEMPLATES/WO-TEMPLATE-CLOSEOUT-UI.md"; return; };;
  esac
  echo "$TEMPLATES/WO-TEMPLATE-CLOSEOUT.md"
}

cmd_integrate() { # open the integration work order for a batch of parallel work orders
  local title="" covers=""
  while [ $# -gt 0 ]; do case "$1" in --covers) covers="$2"; shift 2;; -*) die "unknown flag $1";; *) [ -z "$title" ] && title="$1" || title="$title $1"; shift;; esac; done
  [ -n "$title" ] || die 'usage: wo integrate "<title>" --covers 0002,0003,0004'
  [ -n "$covers" ] || die "an integration work order must name what it covers:  --covers 0002,0003,0004"
  local list suites=""
  list="$(printf '%s' "$covers" | tr ',' ' ')"
  for c in $list; do
    c="$(pad "$c")"
    local cd_; cd_="$(wo_folder "$c")"; [ -n "$cd_" ] || die "no work order WO-$c to cover"
    local f; f="$(ls "$PROJECT_ROOT/${TESTING_DIR:-Workspace/Testing}/suites/" 2>/dev/null | grep -i "^wo-$c-" | head -1)"
    [ -n "$f" ] || die "WO-$c has no suite in ${TESTING_DIR:-Workspace/Testing}/suites/ — every covered work order must be verified on its own first"
    suites="$suites $f"
  done
  suites="${suites# }"
  cmd_new "$title" --size standard --area integration
  local num; num="$(ls -d "$WO_DIR"/WO-* 2>/dev/null | sed 's|.*/WO-||; s|-.*||' | sort -n | tail -1)"
  local d; d="$(wo_folder "$num")"
  meta_set "$d" covers "$(printf '%s' "$list" | tr ' ' ',')"
  local slug; slug="$(basename "$d")"; slug="${slug#WO-$num-}"
  local out="$PROJECT_ROOT/${TESTING_DIR:-Workspace/Testing}/suites/wo-$num-$slug.sh"
  sed -e "s/WO-XXXX/WO-$num/g" -e "s/\[Title\]/$slug/g" -e "s|{{PIPELINE_ROOT}}|${PIPELINE_ROOT#$PROJECT_ROOT/}|g" \
      -e "s|{{TESTING_DIR}}|${TESTING_DIR:-Workspace/Testing}|g" -e "s|{{COVERED_SUITES}}|$suites|g" \
      "$TESTING_TEMPLATES/INTEGRATION-SUITE-TEMPLATE.sh" > "$out"
  chmod +x "$out"
  echo
  echo "Integration work order WO-$num covers: $(printf '%s' "$list" | tr ' ' ',')"
  echo "Suite scaffolded with those suites wired in: ${out#$PROJECT_ROOT/}"
  echo "Write the composition checks — one entity walked across every covered module — then:"
  echo "  wo verify $num --run ${out#$PROJECT_ROOT/}"
}

cmd_suite() { # scaffold a behavioural suite: from the shipped template, or wrapping the project's own runner
  local n="" wrap=""
  while [ $# -gt 0 ]; do
    case "$1" in --wrap) wrap="$2"; shift 2;; -*) die "unknown flag $1";; *) n="$1"; shift;; esac
  done
  [ -n "$n" ] || die "usage: wo suite <number> [--wrap '<command that runs the project's own tests>']"
  local d; d="$(wo_folder "$n")"; [ -n "$d" ] || die "no work order WO-$n under $WO_DIR"
  local slug; slug="$(basename "$d")"; slug="${slug#WO-$n-}"
  local dir="$PROJECT_ROOT/${TESTING_DIR:-Workspace/Testing}/suites" out
  mkdir -p "$dir"; out="$dir/wo-$n-$slug.sh"
  [ -e "$out" ] && die "$out already exists"
  # A project that already tests itself should keep its runner. The default
  # template is an HTTP suite; SUITE_COMMAND in pipeline.config.sh, or --wrap,
  # makes the scaffold a thin wrapper that establishes preconditions and delegates.
  [ -z "$wrap" ] && [ -n "${SUITE_COMMAND:-}" ] && wrap="$SUITE_COMMAND"
  if [ -n "$wrap" ]; then
    wrap="${wrap//\{wo\}/$n}"; wrap="${wrap//\{slug\}/$slug}"
    {
      printf '#!/usr/bin/env bash\n'
      printf '# WO-%s — %s\n' "$n" "$slug"
      printf '# Delegates to the runner this project already has. Exit codes:\n'
      printf '#   0 pass, 77 could not run (a precondition failed; nothing was asserted), anything else fail.\n'
      printf 'set -uo pipefail\n'
      printf 'root="$(cd "$(dirname "$0")" && while [ "$PWD" != / ] && [ ! -f pipeline.config.sh ]; do cd ..; done; pwd)"\n'
      printf 'cd "$root" || exit 77\n\n'
      printf '# --- preconditions: what has to be true before a single check can mean anything ---\n'
      printf '# precondition() { echo "precondition: $*" >&2; exit 77; }\n'
      printf '# [ -n "${BASE_URL:-}" ] || precondition "BASE_URL is not set"\n'
      printf '# curl -fsS "$BASE_URL/health" >/dev/null || precondition "the service is not answering"\n\n'
      printf '# --- the run: its exit code is the verdict ---\n'
      printf '%s\n' "$wrap"
    } > "$out"
  else
    sed -e "s/WO-XXXX/WO-$n/g" -e "s/\[Title\]/$slug/g" -e "s|{{PIPELINE_ROOT}}|${PIPELINE_ROOT#$PROJECT_ROOT/}|g" "$TESTING_TEMPLATES/SUITE-TEMPLATE.sh" > "$out"
  fi
  chmod +x "$out"
  echo "Suite scaffolded: ${out#$PROJECT_ROOT/}"
  if [ -n "$wrap" ]; then echo "It wraps:  $wrap"; echo "Fill in the preconditions (exit 77 when they are not met), then:  wo verify $n --run ${out#$PROJECT_ROOT/}"
  else echo "Fill in the checks, start the service, then:  wo verify $n --run ${out#$PROJECT_ROOT/}"; fi
  return 0
}

cmd_verify() {
  local n="" suite="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in --run) suite="$2"; shift 2;; --force) force=1; shift;; -*) die "unknown flag $1";; *) n="$1"; shift;; esac
  done
  [ -n "$n" ] || die "usage: wo verify <number> [--run <suite.sh>] [--force]"
  local d; d="$(wo_folder "$n")"; [ -n "$d" ] || die "no work order WO-$n"
  export WO_PATHS; WO_PATHS="$(meta_get "$d" paths)"
  local out="$d/WO-$n-VERIFICATION.md" title; title="$(meta_get "$d" title)"; title="${title:-$(basename "$d")}"
  if [ ! -f "$out" ] || [ "$force" -eq 1 ]; then
    render "$(vtemplate "$(meta_get "$d" area)" "$(meta_get "$d" intake)")" "$out" "$n" "$title" "P2"
    printf '\n---\n\n## Execution Record\n\n**Overall status:** NOT EXECUTED — PLAN ONLY\n\n' >> "$out"
    echo "WO-$n verification document created: $out"
  fi
  [ -z "$suite" ] && { echo "Status is NOT EXECUTED — PLAN ONLY until you run something:  wo verify $n --run <suite.sh>"; return 0; }
  [ -f "$suite" ] || die "suite not found: $suite"
  local stamp log rc status fp_before fp_after
  stamp="$(date +%Y%m%d-%H%M%S)-$$"; log="$d/WO-$n-VERIFICATION-$stamp.log"
  echo "Running: $suite"
  # Mark the run before it starts. A verification that is interrupted — a killed
  # process group, a closed laptop — must not leave an older PASS standing as the
  # authoritative answer, and nothing that runs at exit can be relied on to say so.
  fp_before="$(tree_fingerprint)"
  perl -pi -e "s|^\*\*Overall status:\*\* .*|**Overall status:** RUNNING (run $stamp started, tree $fp_before)|" "$out"
  set +e; bash "$suite" >"$log" 2>&1; rc=$?; set -e
  fp_after="$(tree_fingerprint)"
  # Keep evidence portable and shareable: no host paths in the record.
  perl -pi -e "s|\Q$PROJECT_ROOT/\E||g" "$log" 2>/dev/null || true
  # Exit 77 is reserved: "I could not run". A suite whose environment never came up
  # has asserted nothing, and recording that as a failure would put the tool's
  # authority behind a claim about the code that no check ever made.
  if [ "$rc" -eq 0 ]; then status="EXECUTED — PASS"
  elif [ "$rc" -eq 77 ]; then status="NOT EXECUTED — PRECONDITION FAILED"
  else status="EXECUTED — FAIL"; fi
  # The verdict is one bit; the suite usually printed more. Keep the count beside
  # it, so 42 of 43 and 0 of 15 stop reading identically.
  local counts=""; counts="$(check_counts "$log")"
  local checks=""; [ -n "$counts" ] && checks="${counts% *} passed, ${counts#* } failed"
  local shash; shash="$(suite_fingerprint "$suite")"
  # Evidence is a statement about a particular state of the source. If the source
  # moved underneath the suite, the suite did not necessarily read what is there
  # now, and a PASS would be an observation of something that no longer exists.
  local drift=""
  if [ "$fp_before" != "$fp_after" ] && [ "$rc" -eq 0 ]; then
    if [ "${ALLOW_TREE_DRIFT:-0}" = 1 ]; then
      drift="Source changed during the run (tree $fp_before to $fp_after); accepted because ALLOW_TREE_DRIFT=1."
    else
      status="EXECUTED — FAIL"
      drift="Source changed while the suite ran (tree $fp_before at start, $fp_after at end). The suite may never have read what is on disk now, so this run is not evidence about it. Re-run on a still tree. ALLOW_TREE_DRIFT=1 if the suite itself writes into the tree by design."
    fi
  fi
  {
    printf '\n### Run %s\n\n' "$stamp"
    printf -- '- **Status:** %s\n- **Command:** `bash %s`\n- **Exit code:** %s\n- **Log:** `%s`\n' "$status" "$suite" "$rc" "$(basename "$log")"
    [ -n "$checks" ] && printf -- '- **Checks:** %s\n' "$checks"
    printf -- '- **Suite:** `%s` (%s)\n' "${suite#$PROJECT_ROOT/}" "$shash"
    [ -n "$drift" ] && printf -- '- **Source state:** %s\n' "$drift"
    printf '\n' 
    printf '```\n'; tail -60 "$log"; printf '```\n'
  } >> "$out"
  local ratio=""; [ -n "$counts" ] && ratio=", checks ${counts% *}/$(( ${counts% *} + ${counts#* } ))"
  perl -pi -e "s|^\*\*Overall status:\*\* .*|**Overall status:** $status (last run $stamp, tree $fp_after, suite ${suite#$PROJECT_ROOT/}\@$shash$ratio)|" "$out"
  echo "$status (exit $rc${checks:+; $checks}) — recorded in $(basename "$out"), full log in $(basename "$log")"
  [ "$rc" -eq 77 ] && echo "The suite could not establish its preconditions, so nothing was asserted. Fix the environment and run it again."
  local inum; inum="$(meta_get "$d" issue_number)"
  if [ -n "$inum" ] && command -v gh >/dev/null 2>&1; then
    REPO="$(gh_repo)"; [ -n "$REPO" ] && gh issue comment "$inum" --repo "$REPO" --body "$(printf '**Verification %s** — `bash %s` exit %s\n\n```\n%s\n```' "$status" "$suite" "$rc" "$(tail -20 "$log")")" >/dev/null 2>&1 && echo "Result posted to issue #$inum"
  fi
  [ "$rc" -eq 0 ] || return 1
}

cycle_days() { # created-date closeout-file -> whole days between, empty if either is unreadable
  # python does the date arithmetic: BSD date parses a date with -j/-f while GNU
  # date uses -d, and the two stat(1) mtime flags split the same way.
  WO_CREATED="$1" WO_CLOSEOUT="$2" python3 - <<'PYEOF' 2>/dev/null || true
import datetime, os, sys
try:
    started = datetime.datetime.strptime(os.environ["WO_CREATED"], "%Y-%m-%d")
    closed = datetime.datetime.fromtimestamp(os.path.getmtime(os.environ["WO_CLOSEOUT"]))
except (KeyError, ValueError, OSError):
    sys.exit(1)
print(int((closed - started).total_seconds() / 86400))
PYEOF
}

cmd_stats() {
  local total=0 closed=0 evidenced=0 drift=0 open=0 inprog=0 blocked=0 migrated=0 days=0 nd=0 failing=0
  local sizes_t=0 sizes_s=0 sizes_st=0 sizes_l=0; local -a drift_list=() failing_list=()
  for d in "$WO_DIR"/WO-*; do
    [ -d "$d" ] || continue
    total=$((total+1)); local b n; b="$(basename "$d")"; n="${b#WO-}"; n="${n%%-*}"
    case "$(meta_get "$d" size)" in trivial) sizes_t=$((sizes_t+1));; small) sizes_s=$((sizes_s+1));; large) sizes_l=$((sizes_l+1));; *) sizes_st=$((sizes_st+1));; esac
    if ls "$d" | grep -qi -- "WO-$n-CLOSEOUT"; then
      closed=$((closed+1))
      if [ "$(latest_status "$d/WO-$n-VERIFICATION.md")" = PASS ]; then
        evidenced=$((evidenced+1))
      elif [ "$(latest_status "$d/WO-$n-VERIFICATION.md")" = FAIL ]; then
        failing=$((failing+1)); failing_list+=("WO-$n")
      else
        drift=$((drift+1)); drift_list+=("WO-$n")
      fi
      # An adopted item's created date is the day it was adopted, not the day the
      # work began; a cycle time measured from it would be a number known to be wrong.
      local c; c="$(meta_get "$d" created)"
      if [ -n "$c" ] && [ -z "$(meta_get "$d" adopted)" ]; then
        local cyc; cyc="$(cycle_days "$c" "$d/WO-$n-CLOSEOUT.md")"
        [ -n "$cyc" ] && { days=$((days + cyc)); nd=$((nd+1)); }
      fi
    else
      case "$(wo_state "$d" "$n")" in in-progress) inprog=$((inprog+1));; blocked) blocked=$((blocked+1));; migrated|adopted) migrated=$((migrated+1));; *) open=$((open+1));; esac
    fi
  done
  echo "Work orders in $WO_DIR"
  echo
  printf '  %-34s %s\n' "total" "$total"
  printf '  %-34s %s (open %s, in progress %s, blocked %s)\n' "not closed" "$((open+inprog+blocked))" "$open" "$inprog" "$blocked"
  [ "$migrated" -gt 0 ] && printf '  %-34s %s  (recorded history; no verification exists for these)\n' "adopted, not verified" "$migrated"
  printf '  %-34s %s\n' "closed" "$closed"
  [ "$closed" -gt 0 ] && printf '  %-34s %s of %s (%s%%)\n' "closed with executed evidence" "$evidenced" "$closed" "$((evidenced*100/closed))"
  [ "$drift" -gt 0 ] && printf '  %-34s %s  %s\n' "closed WITHOUT evidence (drift)" "$drift" "${drift_list[*]}"
  [ "$failing" -gt 0 ] && printf '  %-34s %s  %s\n' "closed but last run FAILED" "$failing" "${failing_list[*]}"
  [ "$nd" -gt 0 ] && printf '  %-34s %s days\n' "mean open-to-closeout" "$((days/nd))"
  printf '  %-34s trivial %s, small %s, standard %s, large %s\n' "by size" "$sizes_t" "$sizes_s" "$sizes_st" "$sizes_l"
}

cmd_promote() {
  local n="" pack="" allow=0 allow_ph=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --pack) pack="$2"; shift 2;;
      --allow-unsanitized) allow=1; shift;;
      --allow-placeholders) allow_ph=1; shift;;
      -*) die "unknown flag $1";;
      *) n="$1"; shift;;
    esac
  done
  [ -n "$n" ] || die "usage: wo promote <number> [--pack <name>] [--allow-unsanitized] [--allow-placeholders]"
  local d; d="$(wo_folder "$n")"; [ -n "$d" ] || die "no work order WO-$n under $WO_DIR"
  [ "$(latest_status "$d/WO-$n-VERIFICATION.md")" = PASS ] || die "refusing to promote WO-$n: the latest verification is not EXECUTED — PASS ($(latest_status "$d/WO-$n-VERIFICATION.md")). Precedent without evidence is folklore."
  if [ "$allow_ph" -eq 0 ] && [ -f "$d/WO-$n-CLOSEOUT.md" ] && grep -qE "\[Lesson [0-9]\]|\[What was delivered\]|\[Root cause\]|\[Brief|TBD|TODO" "$d/WO-$n-CLOSEOUT.md"; then
    die "refusing to promote WO-$n: the CLOSEOUT still has template placeholders (e.g. '[Lesson 1]').
    The pitfalls are the part the next project needs. Fill them in, or pass --allow-placeholders."
  fi
  pack="${pack:-$PROJECT_SLUG}"
  local pdir="$PACKS_DIR/$pack" tree="workorders"
  [ -x "$PIPELINE_ROOT/bin/sanitize" ] || die "bin/sanitize is missing from $PIPELINE_ROOT/bin — refusing to promote unscanned work. Re-run install.sh."
  if true; then
    rc=0; "$PIPELINE_ROOT/bin/sanitize" "$d" --quiet >/dev/null 2>&1 || rc=$?
    if [ "$rc" -eq 2 ]; then
      if [ "$allow" -eq 0 ]; then
        die "refusing to promote WO-$n: it fails sanitization (secrets, PII, or host paths).
    $PIPELINE_ROOT/bin/sanitize \"$d\"   shows what. Fix, or pass --allow-unsanitized for a private pack."
      fi
    fi
  fi
  mkdir -p "$pdir/$tree"
  local b; b="$(basename "$d")"
  rm -rf "$pdir/$tree/$b"; cp -R "$d" "$pdir/$tree/$b"
  # The tests are what make precedent reusable; a description of a test is not.
  # Every suite the verification record names travels with the work order.
  local carried=() sp
  for sp in $(grep -oE '\*\*Command:\*\* `bash [^`]+`' "$d/WO-$n-VERIFICATION.md" 2>/dev/null | sed -E 's/.*`bash ([^`]+)`.*/\1/' | sort -u); do
    if [ -f "$PROJECT_ROOT/$sp" ]; then mkdir -p "$pdir/$tree/$b/suite"; cp "$PROJECT_ROOT/$sp" "$pdir/$tree/$b/suite/"; carried+=("$sp")
    elif [ -f "$sp" ]; then mkdir -p "$pdir/$tree/$b/suite"; cp "$sp" "$pdir/$tree/$b/suite/"; carried+=("$sp"); fi
  done
  # --- catalog entry: deterministic extraction from the documents ---
  local entry_dir="$pdir/catalog" entry="$pdir/catalog/WO-$n.md" spec close title problem solution pitfalls files
  mkdir -p "$entry_dir"
  spec="$d/WO-$n-SPEC.md"
  if [ ! -f "$spec" ]; then
    spec=""
    for f in "$d"/WO-$n-*.md; do
      case "$(basename "$f")" in *-CHECKLIST*|*-TASK-BREAKDOWN*|*-Prompt*|*-VERIFICATION*|*-CLOSEOUT*|*-sdk-*|*-ui-*) ;; *) spec="$f"; break;; esac
    done
  fi
  close="$d/WO-$n-CLOSEOUT.md"; [ -f "$close" ] || close=""
  title="$(meta_get "$d" title)"; [ -n "$title" ] || title="${b#WO-$n-}"
  section() { awk -v h="$2" 'BEGIN{p=0} /^## /{p=($0 ~ h)} p&&!/^## /{print}' "$1" | sed -e '/^[[:space:]]*$/d' -e '/^---*$/d' | head -n "${3:-6}"; }
  problem="$( [ -f "$spec" ] && section "$spec" "Problem" 6 || true)"
  solution="$( [ -f "$spec" ] && section "$spec" "Solution" 6 || true)"
  pitfalls="$( [ -f "$close" ] && section "$close" "(Lessons|Pitfalls|Gotchas|What Went Wrong)" 10 || true)"
  files="$( [ -f "$close" ] && grep -oE '\`[^\`]+\.[a-z]{1,4}\`' "$close" | sort -u | head -12 | tr '\n' ' ' || true)"
  # A reference that silently dangles in a pack is worse than none: mark what travelled.
  local f2="" ref
  for ref in $files; do
    local bare="${ref#\`}"; bare="${bare%\`}"; local carried_as=""
    for sp in ${carried[@]+"${carried[@]}"}; do [ "$bare" = "$sp" ] && carried_as="suite/$(basename "$sp")"; done
    if [ -n "$carried_as" ]; then f2="$f2\`$carried_as\` "
    elif [ -f "$PROJECT_ROOT/$bare" ] || [ -f "$bare" ]; then f2="$f2$ref (not carried) "
    else f2="$f2$ref "; fi
  done
  files="$f2"
  [ "${#carried[@]}" -gt 0 ] && files="$files$(for sp in "${carried[@]}"; do printf '`suite/%s` ' "$(basename "$sp")"; done | tr -s ' ')"
  {
    printf '## WO-%s — %s\n\n' "$n" "$title"
    printf -- '- **Folder:** `%s/%s`\n' "$tree" "$b"
    printf -- '- **Promoted:** %s from project `%s`\n' "$(date +%F)" "$PROJECT_SLUG"
    [ -n "$problem"  ] && { printf -- '- **Problem:**\n'; printf '%s\n' "$problem"  | sed 's/^/    /'; }
    [ -n "$solution" ] && { printf -- '- **Solution:**\n'; printf '%s\n' "$solution" | sed 's/^/    /'; }
    [ -n "$files"    ] && printf -- '- **Files:** %s\n' "$files"
    printf -- '- **Pitfalls:**\n'
    if [ -n "$pitfalls" ]; then printf '%s\n' "$pitfalls" | sed 's/^/    /'; else printf '    _(none recorded — add what would have saved you time)_\n'; fi
    printf '\n'
  } > "$entry"
  "$PIPELINE_ROOT/bin/pack" catalog "$pack" >/dev/null 2>&1 || true
  echo "WO-$n promoted to pack '$pack': $pdir/$tree/$b"
  echo "Catalog entry written: $entry (CATALOG.md regenerated from catalog/)"
  echo "Edit the Pitfalls lines now, while you still remember."
}

pad() { case "${1:-}" in [0-9]|[0-9][0-9]|[0-9][0-9][0-9]) printf '%04d' "$((10#$1))";; *) printf '%s' "${1:-}";; esac; }
case "${1:-}" in show|start|block|note|verify|publish|sync|promote|status|close|suite) [ $# -ge 2 ] && set -- "$1" "$(pad "$2")" "${@:3}";; esac
case "${1:-}" in
  new)     shift; cmd_new "$@";;
  show)    shift; cmd_show "${1:-}";;
  start)   shift; cmd_start "${1:-}";;
  block)   shift; cmd_block "${1:-}" "${2:-}";;
  note)    shift; cmd_note "${1:-}" "${2:-}";;
  verify)  shift; cmd_verify "$@";;
  suite)   shift; cmd_suite "$@";;
  adopt)   shift; cmd_adopt "$@";;
  fingerprint) shift; export WO_PATHS="${1:-}"; tree_fingerprint;;
  counts) shift; check_counts "${1:?usage: wo counts <log>}";;
  integrate) shift; cmd_integrate "$@";;
  stats)   shift; cmd_stats;;
  publish) shift; cmd_publish "${1:-}";;
  sync)    shift; cmd_sync "${1:-}";;
  import)  shift; cmd_import "$@";;
  promote) shift; cmd_promote "$@";;
  list)   shift; cmd_list "${1:-}";;
  status) shift; cmd_status "${1:-}";;
  route)  shift; cmd_route "${1:-}";;
  close)  shift; cmd_close "${1:-}";;
  *) sed -n '2,39p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1;;
esac
