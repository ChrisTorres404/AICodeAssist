#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# acp — AICodePipeline front door
#
# One command on PATH; everything else is a subcommand that forwards to the
# individual driver. The drivers remain standalone scripts you can call or
# edit directly.
#
#   acp init <path> [--name N] [--domain D] [--pack P]   new project from nothing
#   acp install <path>                                   add to an existing project
#   acp doctor [path]                                    is the install healthy?
#   acp baseline [--command '<cmd>'] [--dry-run]         run the project's own tests once and record the first measurement
#   acp intake [status|inventory]                        the work orders a project completes before it is operational
#   acp kb status|bind|impact                            the knowledge base: what describes the code, and whether it still does
#   acp wo|bug|pack|sanitize|detect-stack <args>         forward to the driver
#   acp check [--staged|--since REF|--paths P...]        the rules over a set of files; blocks on secrets,
#                                                        weakened config, closeouts without evidence
#   acp agent <name>                                     print a specialist's definition (any tool can read it)
#   acp agents [--area A]                                list specialists, or the ones routed for an area
#   acp ci github                                        add a workflow that runs the rules on every pull request
#   acp lint [--strict]                                  validate agents, skills, hooks, rules
#   acp eval list|run [name]|new <name>                  the pipeline's own behavioural evaluations
#   acp test [--live]                                    every check in one command (lint, sanitize, evals, plugin; --live adds real sessions)
#   acp build-plugin [--version X]                       assemble dist/plugin/
#   acp version
#   acp help [command]
# ---------------------------------------------------------------------------
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
BIN="$ROOT/bin"
VERSION="1.3.0"

usage() { sed -n '3,/^# -\{20,\}$/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//'; }

bound_seconds() { # <value> <variable name> -> effective seconds, complaining on stdout if the value was unusable
  local v="$1" name="$2"
  case "$v" in
    ''|*[!0-9]*|0) echo "  ($name='$v' is not a positive number of seconds; using 120)"; echo 120;;
    *) echo "$v";;
  esac
}

run_bounded() { # <seconds> <command...> -> the command's status, 124 on timeout, 2 if the bound is unusable
  # A check that never returns is not a passing check. macOS ships no timeout(1)
  # and bash 3.2 has no wait -n, so this waits by hand and escalates to KILL.
  #
  # A bound that is not a positive integer is refused outright and nothing is
  # started. Quietly substituting a default would launch a long-running command
  # under a bound the caller never asked for, which is the failure this function
  # exists to prevent. Callers that take the value from a user turn it into a
  # number first, out loud: see bound_seconds.
  #
  # The command runs in its own process group and the whole group is signalled,
  # because killing only the immediate child leaves whatever it spawned running.
  # Only the group this function created is ever signalled.
  local secs="${1:-}"; shift || true
  case "$secs" in
    ''|*[!0-9]*) echo "run_bounded: '$secs' is not a number of seconds; nothing was run" >&2; return 2;;
  esac
  [ "$secs" -gt 0 ] 2>/dev/null || { echo "run_bounded: a bound of $secs seconds is not a bound; nothing was run" >&2; return 2; }
  [ "$#" -gt 0 ] || { echo "run_bounded: no command given" >&2; return 2; }
  (
    set -m                      # each background job gets its own process group
    "$@" >/dev/null 2>&1 &
    pid=$!; waited=0
    set +m
    while kill -0 "$pid" 2>/dev/null; do
      if [ "$waited" -ge "$secs" ]; then
        kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
        sleep 1
        kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null
        wait "$pid" 2>/dev/null
        exit 124
      fi
      sleep 1; waited=$((waited + 1))
    done
    wait "$pid"
  ) 2>/dev/null
}

doctor() {
  local target="${1:-$PWD}" fail=0 warn=0
  target="$(cd "$target" 2>/dev/null && pwd)" || { echo "acp doctor: $1 is not a directory" >&2; return 2; }
  ok()   { printf '  \033[32mPASS\033[0m  %s\n' "$*"; }
  bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; fail=$((fail+1)); }
  meh()  { printf '  \033[33mWARN\033[0m  %s\n' "$*"; warn=$((warn+1)); }
  echo "acp doctor — $target"; echo
  for t in python3 perl git; do command -v "$t" >/dev/null && ok "$t available" || bad "$t not found on PATH"; done
  local cfg="$target/pipeline.config.sh" proot=""
  if [ -f "$cfg" ]; then
    ok "pipeline.config.sh present"
    for v in PROJECT_NAME PROJECT_SLUG PIPELINE_ROOT WORKORDERS_DIR BUGS_DIR TESTING_DIR SESSIONS_DIR; do
      grep -qE "^export $v=\"[^\"]+\"" "$cfg" && [ "$(sed -n "s/^export $v=\"\([^\"]*\)\".*/\1/p" "$cfg")" != "" ] || bad "$v is empty in pipeline.config.sh"
    done
    grep -q 'PROJECT_NAME="My Platform"' "$cfg" && meh "PROJECT_NAME still has the example value"
    proot="$(sed -n 's/^export PIPELINE_ROOT="\([^"]*\)".*/\1/p' "$cfg")"
  else
    meh "no pipeline.config.sh — drivers fall back to git root + default layout (plugin mode)"
    proot=".aicodepipeline"
  fi
  local dest="$target/$proot" profile="standard"
  [ -f "$dest/.profile" ] && profile="$(cat "$dest/.profile")"
  if [ ! -f "$cfg" ] && [ ! -d "$dest" ]; then
    meh "no pipeline install here — plugin mode (commands, agents, skills, hooks come from the plugin); install checks skipped"
    git -C "$target" rev-parse --show-toplevel >/dev/null 2>&1 && ok "git repository" || meh "not a git repository"
    echo; echo "plugin mode — $warn note(s)"; return 0
  fi
  if [ -d "$dest" ]; then
    ok "pipeline installed at $proot/"
    for b in acp wo bug pack sanitize detect-stack stack-specialist; do [ -x "$dest/bin/$b" ] && ok "bin/$b executable" || bad "bin/$b missing or not executable (re-run install)"; done
    for h in "$dest"/core/hooks/*.py "$dest"/core/hooks/*.sh; do [ -x "$h" ] || bad "hook $(basename "$h") not executable"; done
    ok "profile: $profile"
    local unres vre="PROJECT_NAME|PROJECT_SLUG|PROJECT_DOMAIN|GITHUB_REPO|PROJECT_ROOT|PIPELINE_ROOT|WORKSPACE_DIR|DOCS_DIR|WORKORDERS_DIR|BUGS_DIR|TESTING_DIR|SESSIONS_DIR|API_APP|ADMIN_APP|PORTAL_APP|DEV_APP|WEB_APP|SDK_PKG|DB_NAME|CLI_NAME|API_BASE_URL|WEB_ORIGIN|STACK_SECTION"
    unres="$(grep -rhoE "\{\{(${vre})\}\}" "$dest/core" "$dest/harness" --exclude-dir=project --exclude-dir=templates 2>/dev/null | sort -u | tr '\n' ' ' || true)"
    [ -d "$dest/packs" ] && ok "packs/ present" || bad "no packs/ directory (re-run install)"
    [ -z "$unres" ] && ok "no unresolved template variables" || bad "unresolved variables: $unres"
  else
    bad "no pipeline at $proot/ — run: acp install $target"
  fi
  local st="$target/.claude/settings.json"
  if [ -f "$st" ]; then
    if python3 -c "import json,sys; d=json.load(open('$st')); h=d.get('hooks',{}); sys.exit(0 if any('acp:' in x.get('command','') for ev in h.values() for e in ev for x in e.get('hooks',[])) else 1)" 2>/dev/null; then
      ok "hooks wired in .claude/settings.json"
    elif [ "$profile" = "minimal" ]; then ok "no hooks (minimal profile)"
    else bad "no acp: hooks in .claude/settings.json"; fi
  else bad ".claude/settings.json missing"; fi
  # A count that cannot tell 162 working skills from 161 and one broken is not
  # worth printing. Lint opens every file; the count is reported with its result.
  local lrc=0 lline; lline="$("$dest/bin/lint" "$dest" 2>/dev/null | tail -1)" || lrc=$?
  local lerr; lerr="$(printf '%s' "$lline" | sed -n 's/^\([0-9]*\) error(s).*/\1/p')"; lerr="${lerr:-?}"
  local nag nsk; nag="$(ls "$target/.claude/agents" 2>/dev/null | wc -l | tr -d ' ')"; nsk="$(ls "$target/.claude/skills" 2>/dev/null | wc -l | tr -d ' ')"
  # What Claude Code loads is the copy under .claude/, so that copy is what has to
  # parse. The same frontmatter rule the linter applies, over those files.
  local bad_fm; bad_fm="$(python3 - "$target/.claude/agents" "$target/.claude/skills" <<'PYEOF'
import os, re, sys
def yaml_ok(fm):
    try:
        import yaml
        try: yaml.safe_load(fm); return True
        except Exception: return False
    except ImportError: pass
    prev_block = False
    for line in fm.split("\n"):
        if not line.strip(): continue
        if line.startswith((" ", "\t")):
            if not prev_block and not re.match(r"^\s+- ", line) and not re.match(r"^\s+\S+: ", line): return False
            continue
        m = re.match(r"^([A-Za-z_][\w-]*):(\s*(.*))?$", line)
        if not m: return False
        val = (m.group(3) or "").strip()
        if re.match(r"^[>|][-+]?\S", val): return False
        prev_block = val in (">", ">-", "|", "|-", ">+", "|+", "")
    return True
bad = []
for root in sys.argv[1:]:
    for d, _, files in os.walk(root):
        for f in files:
            if not f.endswith(".md"): continue
            p = os.path.join(d, f)
            try: t = open(p, encoding="utf-8", errors="ignore").read()
            except OSError: continue
            m = re.match(r"^---\n(.*?)\n---\n", t, re.S)
            if m and not yaml_ok(m.group(1)): bad.append(os.path.relpath(p, os.path.dirname(root)))
print(len(bad)); [print("  " + b) for b in bad[:5]]
PYEOF
)"
  local nbad; nbad="$(printf '%s\n' "$bad_fm" | head -1)"; nbad="${nbad:-0}"
  if [ -d "$target/.claude/agents" ] && [ -d "$target/.claude/skills" ]; then
    if [ "$nbad" != 0 ]; then bad "agents: $nag, skills: $nsk — $nbad definition(s) under .claude/ do not parse and will never fire:$(printf '%s\n' "$bad_fm" | tail -n +2 | tr '\n' ' ')"
    elif [ "$lerr" = 0 ]; then ok "agents: $nag, skills: $nsk — every definition parses (lint: $lline)"
    else bad "agents: $nag, skills: $nsk — lint reports $lerr error(s); a definition that does not parse is installed and never fires:  $dest/bin/lint $dest"; fi
  else
    [ -d "$target/.claude/agents" ] || bad "no .claude/agents"; [ -d "$target/.claude/skills" ] || bad "no .claude/skills"
  fi
  [ -d "$target/.claude/rules" ] && ok "rules: $(ls "$target/.claude/rules" | tr '\n' ' ')" || meh "no .claude/rules (plugin mode: copy sets from rules/)"
  local ins=""; for c in AGENTS.md CLAUDE.md; do [ -f "$target/$c" ] && { ins="$c"; break; }; done
  if [ -n "$ins" ]; then
    grep -q '{{' "$target/$ins" && bad "$ins has unresolved {{variables}}" || ok "$ins present"
    # Instructions are authored content and are never rewritten by install, so a
    # workspace that moved leaves them pointing at folders that no longer exist.
    local wod2; wod2="$(sed -n 's/^export WORKORDERS_DIR="\([^"]*\)".*/\1/p' "$cfg" 2>/dev/null)"; wod2="${wod2:-Workspace/Docs/WorkOrders}"
    grep -qF "$wod2" "$target/$ins" 2>/dev/null || meh "$ins never mentions the configured work-order directory ($wod2); if the layout changed since it was written, its paths are stale — update it"
    grep -q '_(the command)_\|_(fill in)_\|_(empty project' "$target/$ins" && meh "$ins Project Specifics still has placeholders — run: $proot/bin/detect-stack . --write"
  else meh "no instructions file (AGENTS.md); agents get no methodology — re-run install"; fi
  local wod; wod="$(sed -n 's/^export WORKORDERS_DIR="\([^"]*\)".*/\1/p' "$cfg" 2>/dev/null)"; wod="${wod:-Workspace/Docs/WorkOrders}"
  [ -d "$target/$wod" ] && ok "work orders: $(ls -d "$target/$wod"/WO-* 2>/dev/null | wc -l | tr -d ' ')" || meh "no work-order directory yet ($wod)"
  if git -C "$target" rev-parse --show-toplevel >/dev/null 2>&1; then
    if git -C "$target" rev-parse HEAD >/dev/null 2>&1; then
      ok "git repository ($(git -C "$target" rev-parse --short HEAD), $(git -C "$target" status --porcelain 2>/dev/null | wc -l | tr -d ' ') uncommitted path(s))"
      # Evidence is bound to a source state. Without a remote there is nothing to
      # say whether this directory is the project of record.
      if git -C "$target" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
        local ab; ab="$(git -C "$target" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null || echo '? ?')"
        ok "remote: behind ${ab%% *}, ahead ${ab##* } of $(git -C "$target" rev-parse --abbrev-ref '@{upstream}')"
      elif [ -n "$(git -C "$target" remote 2>/dev/null)" ]; then meh "a remote is configured but this branch tracks nothing; the pushed tree may not be this tree"
      else meh "no remote: nothing says whether this directory is the project of record"; fi
    else
      meh "git repository with no commits yet: evidence binds to a source state, and there is none to return to — commit first"
    fi
    # The tool hook cannot see a message that arrives by file or editor; git can.
    # Ask git where it looks, rather than inferring: a linked worktree and
    # core.hooksPath both put the hook somewhere the obvious guess is wrong.
    local cm; cm="$(cd "$target" && git rev-parse --git-path hooks/commit-msg 2>/dev/null || true)"
    case "$cm" in ''|/*) ;; *) cm="$target/$cm";; esac
    if [ -z "$cm" ] || [ ! -f "$cm" ]; then
      meh "no commit-msg hook; a reference to a work order that does not exist can still be committed by file — re-run install to wire it"
    elif ! grep -q 'acp:commit-msg:wo-reference' "$cm" 2>/dev/null; then
      meh "commit-msg hook is not the pipeline's, so traceability only covers messages typed into the command; chain the check into your hook (README: The commit-msg hook)"
    elif [ ! -x "$cm" ]; then
      # git skips a hook it cannot execute, and says so only in a warning nobody reads.
      bad "commit-msg hook is present but not executable, so git ignores it and phantom references commit freely: chmod +x $cm"
    else
      ok "commit-msg hook wired and executable (traceability holds for messages given by file or editor)"
    fi
    local pc; pc="$(cd "$target" && git rev-parse --git-path hooks/pre-commit 2>/dev/null || true)"
    case "$pc" in ''|/*) ;; *) pc="$target/$pc";; esac
    if [ -n "$pc" ] && [ -x "$pc" ] && grep -q 'acp:pre-commit:check' "$pc" 2>/dev/null; then ok "pre-commit hook wired (the rules run on every commit, under any agent)"
    elif [ -n "$pc" ] && [ -f "$pc" ]; then meh "pre-commit hook is not the pipeline's; chain 'acp check --staged' into it to run the rules at commit time"
    elif [ "$profile" = minimal ]; then ok "no pre-commit hook (minimal profile)"
    else meh "no pre-commit hook; a closeout written by hand or a commit that skips the driver is caught by nothing — re-run install"; fi
    [ -f "$target/.github/workflows/acp-check.yml" ] && ok "CI runs the rules on pull requests" || meh "no CI workflow for the rules; 'acp ci github' adds one so nothing depends on the agent or the machine"
  else
    meh "not a git repository: the work-order gates hold, but nothing catches a closeout written by hand or a commit that skips the driver"
    meh "    a local repository costs nothing and turns that on:  (cd \"$target\" && git init) && $proot/bin/acp install \"$target\""
  fi
  if [ -f "$target/CLAUDE.md" ]; then
    grep -q '@AGENTS.md' "$target/CLAUDE.md" 2>/dev/null && ok "CLAUDE.md imports AGENTS.md" || meh "CLAUDE.md does not import AGENTS.md; Claude Code and other agents are reading different instructions"
  fi
  # Structure says nothing about whether the project's own tests pass. The
  # baseline is the first measurement, and everything recorded after it is
  # relative to it.
  local tdir bl; tdir="$(sed -n 's/^export TESTING_DIR="\([^"]*\)".*/\1/p' "$cfg" 2>/dev/null)"; tdir="${tdir:-Workspace/Testing}"; bl="$target/$tdir/results/BASELINE.md"
  if [ -f "$bl" ]; then
    local bfp cfp; bfp="$(grep -m1 -oE 'tree [0-9a-f]{16}' "$bl" | cut -d' ' -f2 || true)"; cfp="$(cd "$target" && "$dest/bin/wo" fingerprint 2>/dev/null || true)"
    if [ -n "$bfp" ] && [ "$bfp" = "$cfp" ]; then ok "baseline recorded against this exact tree: $(sed -n 's/^- \*\*Result:\*\* //p' "$bl" | head -1 | cut -c1-60)"
    else ok "baseline recorded ($(sed -n 's/^- \*\*Result:\*\* //p' "$bl" | head -1 | cut -c1-60)); the tree has changed since — re-run:  acp baseline"; fi
  else meh "no baseline: the project's own tests have never been run under this tool, so nothing recorded here is relative to a known state — run:  acp baseline"; fi
  # Installation is six work orders; operational means all six closed on evidence.
  if [ -d "$dest/core/templates/intake" ]; then
    local il; il="$(cd "$target" && "$dest/bin/acp" intake status 2>/dev/null | tail -1 || true)"
    case "$il" in
      operational*) ok "intake: $il";;
      "not yet operational"*) meh "intake: $il — run:  acp intake status";;
      *) meh "intake: no intake work orders yet — run:  acp intake";;
    esac
  fi
  local kbdir; kbdir="$(sed -n 's/^export KNOWLEDGE_DIR="\([^"]*\)".*/\1/p' "$cfg" 2>/dev/null)"; kbdir="${kbdir:-Workspace/Docs/KnowledgeBase}"
  if [ -f "$dest/core/hooks/kb.py" ]; then
    if [ -d "$target/$kbdir" ]; then
      local kl krc=0; kl="$(python3 "$dest/core/hooks/kb.py" status --root "$target" --kb "$target/$kbdir" 2>/dev/null | tail -1)" || krc=$?
      case "$krc" in 0) ok "knowledge base: $kl";; 1) meh "knowledge base: $kl — profiles describe code that changed; update them, then  acp kb bind";; 2) bad "knowledge base: $kl — profiles cite files or lines that no longer exist";; *) meh "knowledge base: $kl";; esac
    else meh "no knowledge base: nothing describes this repository yet — the intake work order for it says how"; fi
  fi
  # Reporting "healthy" while the drivers cannot actually complete a lifecycle is
  # the worst failure a doctor can have: prove one end to end, here, now.
  if [ -x "$dest/bin/wo" ]; then
    # The drivers resolve the project from the working directory, so the probe has
    # to run inside the target. Doctoring one project must never write into another.
    local tabs probe pn
    tabs="$(cd "$target" && pwd)"
    probe="$tabs/.acp-doctor-probe.$$"
    printf '#!/usr/bin/env bash\nexit 0\n' > "$probe" && chmod +x "$probe"
    pn="$(cd "$tabs" && "$dest/bin/wo" new "acp doctor probe" --size trivial --area docs 2>/dev/null | grep -o 'WO-[0-9]*' | head -1)"
    if [ -n "$pn" ]; then
      pn="${pn#WO-}"
      # The probe's verification document is untouched template, so the placeholder
      # gate would refuse the close. That gate is for human work, not for this.
      if ( cd "$tabs" && "$dest/bin/wo" verify "$pn" --run "$probe" >/dev/null 2>&1 \
             && ALLOW_PLACEHOLDERS=1 "$dest/bin/wo" close "$pn" >/dev/null 2>&1 ); then
        ok "lifecycle probe: a work order opened, verified and closed in this layout"
      else bad "lifecycle probe failed: the drivers cannot complete a work order here"; fi
      local wod pd; wod="$(sed -n 's/^export WORKORDERS_DIR="\([^"]*\)".*/\1/p' "$cfg" 2>/dev/null)"; wod="${wod:-Workspace/Docs/WorkOrders}"
      pd="$(find "$tabs/$wod" -maxdepth 1 -type d -name "WO-$pn-*" 2>/dev/null | head -1)"; [ -n "$pd" ] && rm -rf "$pd"
    else bad "lifecycle probe: wo new failed in this layout"; fi
    rm -f "$probe"
  fi
  echo
  if [ "$fail" -gt 0 ]; then echo "$fail failure(s), $warn warning(s)"; return 1; fi
  echo "healthy — $warn warning(s)"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  init)          exec "$BIN/new-project" "$@";;
  install)       exec "$BIN/install.sh" "$@";;
  doctor)        doctor "${1:-}";;
  wo)            exec "$BIN/wo" "$@";;
  check)
    # One implementation of the rules, callable from anywhere: wo close, a git
    # pre-commit hook, CI, or by hand. Works with or without git.
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    ex=()
    if [ -f "$root/pipeline.config.sh" ]; then
      for k in WORKORDERS_DIR BUGS_DIR SESSIONS_DIR KNOWLEDGE_DIR; do v="$(sed -n "s/^export $k=\"\([^\"]*\)\".*/\1/p" "$root/pipeline.config.sh" | head -1)"; [ -n "$v" ] && ex+=("$v"); done
    fi
    ex+=("${ROOT#$root/}")
    exec python3 "$ROOT/core/hooks/check.py" --root "$root" --exclude "${ex[@]}" "$@";;
  intake)
    # Installation is work, and work here is a work order. Six of them, each with a
    # shipped spec and a shipped suite, and the project is operational when every
    # one has closed on an executed pass. Idempotent: an existing step is kept.
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    cfg="$root/pipeline.config.sh"; [ -f "$cfg" ] || { echo "acp intake: no pipeline.config.sh at $root; install first" >&2; exit 1; }
    wod="$(sed -n 's/^export WORKORDERS_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; wod="${wod:-Workspace/Docs/WorkOrders}"
    bugd="$(sed -n 's/^export BUGS_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; bugd="${bugd:-Workspace/Docs/Bugs}"
    tdir="$(sed -n 's/^export TESTING_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; tdir="${tdir:-Workspace/Testing}"
    rel="${ROOT#$root/}"; T="$ROOT/core/templates/intake"
    intake_state() { # step -> closed | verified | open | missing, and the number
      local st="" num="" dd
      for dd in "$root/$wod"/WO-*; do
        [ -f "$dd/.wo-meta" ] && [ "$(sed -n 's/^intake=//p' "$dd/.wo-meta" | head -1)" = "$1" ] || continue
        num="$(basename "$dd")"; num="${num#WO-}"; num="${num%%-*}"
        if ls "$dd" | grep -qi "WO-$num-CLOSEOUT"; then st=closed
        elif grep -q 'EXECUTED — PASS' "$dd/WO-$num-VERIFICATION.md" 2>/dev/null; then st=verified
        else st=open; fi
        break
      done
      printf '%s %s\n' "${st:-missing}" "$num"
    }
    case "${1:-}" in
      status)
        [ -d "$T" ] || { echo "acp intake: no intake templates shipped with this pipeline" >&2; exit 1; }
        closed=0; total=0
        printf '  %-4s %-8s %-10s %s\n' "STEP" "WO" "STATE" "TITLE"
        for spec in "$T"/INTAKE-0*.md; do
          [ -f "$spec" ] || continue; total=$((total+1))
          step="$(basename "$spec" .md)"; n="${step#INTAKE-}"; n="${n%%-*}"; title="$(grep -m1 '^# ' "$spec" | sed 's/^# *WO-XXXX: *//; s/^# *//')"
          set -- $(intake_state "$n"); st="$1"; num="${2:-}"
          [ "$st" = closed ] && closed=$((closed+1))
          printf '  %-4s %-8s %-10s %s\n' "$n" "${num:+WO-$num}" "$st" "$title"
        done
        echo; [ "$closed" -eq "$total" ] && echo "operational: every intake step has closed on executed evidence" || echo "not yet operational: $closed of $total intake steps closed with evidence"
        [ "$closed" -eq "$total" ];;
      inventory)
        py="$ROOT/core/hooks/inventory.py"; [ -f "$py" ] || { echo "acp intake: inventory engine missing" >&2; exit 1; }
        kbd="$(sed -n 's/^export KNOWLEDGE_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; kbd="${kbd:-Workspace/Docs/KnowledgeBase}"
        # The inventory is part of the repository's description, so it lives with
        # the knowledge base, outside the evidence fingerprint.
        out="$root/$kbd/INDEX.md"; mkdir -p "$(dirname "$out")"
        python3 "$py" --root "$root" --workorders-dir "$wod" --bugs-dir "$bugd" --testing-dir "$tdir" --pipeline-dir "$rel" --knowledge-dir "$kbd" --out "$out" >/dev/null && echo "wrote ${out#$root/}: what this repository is, the shape of its record, and how to bring it in" || exit 1;;
      "")
        [ -d "$T" ] || { echo "acp intake: no intake templates shipped with this pipeline" >&2; exit 1; }
        W="$ROOT/bin/wo"; opened=0; kept=0
        for spec in "$T"/INTAKE-0*.md; do
          [ -f "$spec" ] || continue
          step="$(basename "$spec" .md)"; n="${step#INTAKE-}"; n="${n%%-*}"; slug="${step#INTAKE-0?-}"
          title="$(grep -m1 '^# ' "$spec" | sed 's/^# *WO-XXXX: *//; s/^# *//')"
          set -- $(intake_state "$n"); [ "$1" != missing ] && { kept=$((kept+1)); continue; }
          case "$slug" in knowledge-base) area=analysis;; baseline|suites) area=testing;; *) area=docs;; esac
          num="$(cd "$root" && "$W" new "$title" --size small --area "$area" 2>/dev/null | grep -o 'WO-[0-9]*' | head -1)"; num="${num#WO-}"
          [ -n "$num" ] || { echo "acp intake: could not open step $n" >&2; continue; }
          dd="$(find "$root/$wod" -maxdepth 1 -type d -name "WO-$num-*" | head -1)"
          # the shipped spec replaces the template: complete prose, nothing to fill in
          spec_out="$dd/WO-$num-SPEC.md"
          { sed -e "s/WO-XXXX/WO-$num/g" -e "s|{{PIPELINE_ROOT}}|$rel|g" "$spec"
            [ -f "$spec_out" ] && awk '/^## Specialists for this work order/{p=1} p' "$spec_out" | sed '1s/^/\n---\n\n/'
          } > "$spec_out.new" && mv "$spec_out.new" "$spec_out"
          printf 'intake=%s\n' "$n" >> "$dd/.wo-meta"
          suite_src="$T/intake-$n-$slug.sh"; suite_dst="$root/$tdir/suites/intake-$n-$slug.sh"
          if [ -f "$suite_src" ]; then mkdir -p "$(dirname "$suite_dst")"; sed -e "s|{{PIPELINE_ROOT}}|$rel|g" "$suite_src" > "$suite_dst"; chmod +x "$suite_dst"; fi
          opened=$((opened+1))
          printf '  WO-%s  %s\n' "$num" "$title"
        done
        echo "intake: $opened step(s) opened, $kept already present. Each has a shipped suite under $tdir/suites/;"
        echo "        verify a step with  wo verify <n> --run $tdir/suites/intake-0N-<step>.sh   and close it. Then:  acp intake status";;
      *) echo "usage: acp intake [status|inventory]" >&2; exit 1;;
    esac;;
  kb)
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    kbd="Workspace/Docs/KnowledgeBase"
    [ -f "$root/pipeline.config.sh" ] && { v="$(sed -n 's/^export KNOWLEDGE_DIR="\([^"]*\)".*/\1/p' "$root/pipeline.config.sh" | head -1)"; [ -n "$v" ] && kbd="$v"; }
    py="$ROOT/core/hooks/kb.py"; [ -f "$py" ] || { echo "acp kb: engine missing ($py)" >&2; exit 1; }
    sub="${1:-status}"; shift || true
    case "$sub" in
      status|bind|impact) exec python3 "$py" "$sub" --root "$root" --kb "$root/$kbd" "$@";;
      *) echo "usage: acp kb status|bind|impact [--files ...]" >&2; exit 1;;
    esac;;
  baseline)
    # The first measurement of a project the tool is about to record evidence
    # about. Structure checks pass on a codebase whose tests have been dead for a
    # month; this is the step that asks.
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    cfg="$root/pipeline.config.sh"; tdir="Workspace/Testing"; bcmd=""; wod="Workspace/Docs/WorkOrders"
    if [ -f "$cfg" ]; then
      v="$(sed -n 's/^export TESTING_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; [ -n "$v" ] && tdir="$v"
      v="$(sed -n 's/^export WORKORDERS_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; [ -n "$v" ] && wod="$v"
      v="$(sed -n 's/^export BASELINE_COMMAND="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; [ -n "$v" ] && bcmd="$v"
    fi
    dry=0; while [ $# -gt 0 ]; do case "$1" in --command) bcmd="$2"; shift 2;; --dry-run) dry=1; shift;; *) echo "usage: acp baseline [--command '<test command>'] [--dry-run]" >&2; exit 1;; esac; done
    echo "== baseline for $root"
    # 1. a source state that can be returned to
    if ! git -C "$root" rev-parse --show-toplevel >/dev/null 2>&1; then
      echo "  no git repository. A baseline is a measurement of a source state, and without one"
      echo "  there is nothing to return to. Create it first:  (cd \"$root\" && git init && git add -A && git commit -m baseline)"; exit 1
    fi
    if ! git -C "$root" rev-parse HEAD >/dev/null 2>&1; then
      echo "  the repository has no commits. Commit the tree as it stands, then run this again:"
      echo "      (cd \"$root\" && git add -A && git commit -m baseline)"; exit 1
    fi
    sha="$(git -C "$root" rev-parse --short HEAD)"; dirty="$(git -C "$root" status --porcelain | wc -l | tr -d ' ')"
    echo "  source: $sha with $dirty uncommitted path(s)"
    if git -C "$root" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
      ab="$(git -C "$root" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null || echo '? ?')"; up="$(git -C "$root" rev-parse --abbrev-ref '@{upstream}')"
      echo "  remote: behind ${ab%% *}, ahead ${ab##* } of $up"
      [ "${ab%% *}" != 0 ] && echo "          the pushed tree is not this tree; decide which one is the project of record before trusting this baseline"
    else echo "  remote: none tracked — nothing says whether this directory is the project of record"; fi
    # 2. what the project already runs
    if [ -z "$bcmd" ] && [ -x "$ROOT/bin/detect-stack" ]; then
      bcmd="$("$ROOT/bin/detect-stack" "$root" --json 2>/dev/null | python3 -c 'import json,sys; print((json.load(sys.stdin).get("commands") or {}).get("test",""))' 2>/dev/null || true)"
    fi
    [ -n "$bcmd" ] || { echo "  no test command found. Give one:  acp baseline --command 'npm test'   (or set BASELINE_COMMAND in pipeline.config.sh)"; exit 1; }
    echo "  command: $bcmd"
    fp="$(cd "$root" && "$ROOT/bin/wo" fingerprint 2>/dev/null || echo nofp)"
    [ "$dry" -eq 1 ] && { echo "  (dry run: nothing executed; would record against tree $fp)"; exit 0; }
    # 3. run it, and record the result as the first measurement
    mkdir -p "$root/$tdir/results"; blog="$root/$tdir/results/BASELINE.log"; bl="$root/$tdir/results/BASELINE.md"
    echo "  running…"; brc=0; ( cd "$root" && bash -c "$bcmd" ) > "$blog" 2>&1 || brc=$?
    counts="$("$ROOT/bin/wo" counts "$blog" 2>/dev/null || true)"
    case "$brc" in 0) res="PASS";; 77) res="COULD NOT RUN (exit 77)";; *) res="FAIL (exit $brc)";; esac
    [ -n "$counts" ] && res="$res, ${counts% *} passed, ${counts#* } failed"
    # 4. the record versus the measurement
    total=0; adopted=0; verified=0; nover=0
    for d in "$root/$wod"/WO-*; do
      [ -d "$d" ] || continue; total=$((total+1))
      grep -q '^adopted=' "$d/.wo-meta" 2>/dev/null && adopted=$((adopted+1))
      if ls "$d" | grep -qi VERIFICATION; then grep -q 'EXECUTED — PASS' "$d"/*VERIFICATION.md 2>/dev/null && verified=$((verified+1)); else nover=$((nover+1)); fi
    done
    {
      printf '# Baseline\n\nThe first measurement of this project under the pipeline. Everything recorded after it is relative to this.\n\n'
      printf -- '- **Taken:** %s\n- **Source:** %s, %s uncommitted path(s), tree %s\n- **Command:** `%s`\n- **Result:** %s\n- **Log:** `%s`\n\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sha" "$dirty" "$fp" "$bcmd" "$res" "$(basename "$blog")"
      printf '## The record against the measurement\n\n'
      printf -- '- work orders on file: %s (%s adopted from an earlier record)\n- with an executed pass under this tool: %s\n- with no verification at all: %s\n\n' "$total" "$adopted" "$verified" "$nover"
      printf 'A recorded completion is a claim. Only the ones with an executed pass above are measured; the rest are recorded, not verified.\n\n'
      printf '```\n'; tail -40 "$blog"; printf '```\n'
    } > "$bl"
    echo "  result: $res"
    echo "  record: $total work orders, $adopted adopted, $verified with an executed pass, $nover with no verification"
    echo "  written: ${bl#$root/}"
    [ "$brc" -eq 0 ] || { echo "  a failing baseline is information, not a block: it is the state the project is actually in"; exit 1; };;
  ci)
    case "${1:-}" in
      github)
        root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
        dest="$root/.github/workflows/acp-check.yml"
        [ -f "$dest" ] && { echo "acp: $dest exists — left alone"; exit 0; }
        mkdir -p "$(dirname "$dest")"
        rel="${ROOT#$root/}"
        sed "s|{{PIPELINE_ROOT}}|$rel|g" "$ROOT/core/templates/ci/acp-check.yml" > "$dest"
        echo "wrote ${dest#$root/}: the rules run on every pull request, whoever made the commits";;
      *) echo "usage: acp ci github" >&2; exit 1;;
    esac;;
  agent)
    n="${1:-}"; [ -n "$n" ] || { echo "usage: acp agent <name>   (acp agents lists them)" >&2; exit 1; }
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    for c in "$root/.claude/agents/$n.md" "$ROOT/core/agents/base/$n.md" "$ROOT/core/agents/roles/$n.md" "$ROOT/core/agents/domain/$n.md" "$ROOT/agents/$n.md"; do
      [ -f "$c" ] && exec cat "$c"
    done
    echo "acp: no specialist named '$n'" >&2; exit 1;;
  agents)
    if [ "${1:-}" = "--area" ] && [ -n "${2:-}" ]; then
      exec "$BIN/wo" route "$2"
    fi
    for d in "$ROOT/core/agents/base" "$ROOT/core/agents/roles" "$ROOT/core/agents/domain" "$ROOT/agents"; do
      [ -d "$d" ] || continue
      for f in "$d"/*.md; do [ -f "$f" ] || continue; printf '  %-34s %s\n' "$(basename "$f" .md)" "$(sed -n 's/^description: *//p' "$f" | head -1 | cut -c1-90)"; done
    done;;
  bug)           exec "$BIN/bug" "$@";;
  pack)          exec "$BIN/pack" "$@";;
  sanitize)      exec "$BIN/sanitize" "$@";;
  detect-stack)  exec "$BIN/detect-stack" "$@";;
  eval)          exec "$BIN/eval" "$@";;
  test)
    live=0; for a in "$@"; do [ "$a" = "--live" ] && live=1; done
    rc=0
    echo "== lint";      "$BIN/lint" | tail -1 || rc=1; "$BIN/lint" >/dev/null 2>&1 || rc=1
    # An installed copy ships a subset of these directories, and sanitize reserves
    # exit 3 for its own usage errors: neither is a critical finding.
    echo "== sanitize"
    for d in core bin docs harness packs; do
      [ -d "$ROOT/$d" ] || continue
      r=0; "$BIN/sanitize" "$ROOT/$d" --quiet >/dev/null 2>&1 || r=$?
      case "$r" in
        0|1) echo "  $d clean";;
        2)   echo "  $d FAIL (critical findings)"; rc=1;;
        *)   echo "  $d FAIL (sanitize could not scan it, exit $r)"; rc=1;;
      esac
    done
    if [ -f "$ROOT/pipeline.config.example.sh" ]; then echo "== evaluations (pipeline repository: full suite)"
    else echo "== evaluations (installed copy: the ones needing source fixtures are skipped)"; fi
    "$BIN/eval" run || rc=1
    # Packaging the plugin is something only the pipeline repository can do; an
    # installed copy has no packaging inputs, and failing it there would be noise.
    if [ -f "$ROOT/pipeline.config.example.sh" ]; then
      echo "== plugin"
      # bound_seconds prints its complaint first and the effective value last
      bs="$(bound_seconds "${ACP_PLUGIN_TIMEOUT:-120}" ACP_PLUGIN_TIMEOUT)"
      echo "$bs" | sed '$d' | grep . || true
      local_to="$(echo "$bs" | tail -1)"
      r=0; run_bounded "$local_to" "$BIN/build-plugin" || r=$?
      case "$r" in
        0)   echo "  built dist/plugin";;
        124) echo "  build-plugin timed out after ${local_to}s"; rc=1;;
        *)   echo "  build-plugin FAILED"; rc=1;;
      esac
      if [ "$r" -eq 0 ]; then
        if [ "${ACP_SKIP_PLUGIN_VALIDATE:-0}" = 1 ]; then echo "  (plugin validation skipped by request)"
        elif command -v claude >/dev/null 2>&1; then
          # The validator is an external CLI. It has hung here; bound it rather than
          # let one third-party command hold the whole suite open indefinitely.
          vr=0
          run_bounded "$local_to" claude plugin validate "$ROOT/dist/plugin" || vr=$?
          [ "$vr" -eq 0 ] && { run_bounded "$local_to" claude plugin validate "$ROOT/dist/plugin/.claude-plugin/plugin.json" || vr=$?; }
          case "$vr" in
            0)   echo "  plugin and marketplace manifests validate";;
            124) echo "  plugin validation timed out after ${local_to}s (ACP_PLUGIN_TIMEOUT to raise it, ACP_SKIP_PLUGIN_VALIDATE=1 to skip)"; rc=1;;
            *)   echo "  plugin validation FAILED (run: claude plugin validate dist/plugin/.claude-plugin/plugin.json)"; rc=1;;
          esac
        else echo "  (claude CLI not found; plugin validation skipped)"; fi
      fi
    fi
    [ -x "$BIN/maintenance/portability-check.sh" ] && { echo "== portability"; "$BIN/maintenance/portability-check.sh" || rc=1; }
    if [ "$live" -eq 1 ]; then echo "== live sessions"; "$BIN/eval" live || rc=1; fi
    echo; [ "$rc" -eq 0 ] && echo "ALL CHECKS PASSED" || echo "CHECKS FAILED"; exit "$rc";;
  lint)          exec "$BIN/lint" "$ROOT" "$@";;
  build-plugin)  exec "$BIN/build-plugin" "$@";;
  version|-v|--version) echo "AICodePipeline $VERSION";;
  help|-h|--help)
    case "${1:-}" in
      wo|bug|pack) exec "$BIN/$1";;
      *) usage;;
    esac;;
  *) echo "acp: unknown command '$cmd'" >&2; usage >&2; exit 1;;
esac
