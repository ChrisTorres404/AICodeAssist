#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# build-plugin — assemble a Claude Code plugin from core/ into dist/plugin/
#
#   bin/build-plugin [--version X.Y.Z]
#
# A plugin needs agents/, skills/, commands/, and hooks/hooks.json at its root,
# with hook commands rooted at ${CLAUDE_PLUGIN_ROOT}. core/ is laid out for the
# per-project installer, so this rearranges rather than restructures.
#
# The manifest deliberately declares only commands and skills. agents/ and
# hooks/hooks.json are discovered by convention; declaring them breaks
# validation on current Claude Code. Do not add them.
# ---------------------------------------------------------------------------
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="1.0.0"
[ "${1:-}" = "--version" ] && VERSION="$2"
OUT="$ROOT/dist/plugin"
rm -rf "$OUT"; mkdir -p "$OUT"/{agents,skills,commands,hooks,bin,rules,workflows,.claude-plugin}

cp -p "$ROOT"/core/agents/base/*.md "$ROOT"/core/agents/roles/*.md "$OUT/agents/"
rm -f "$OUT/agents/README.md"
for d in "$ROOT"/core/skills/*/; do mkdir -p "$OUT/skills/$(basename "$d")"; cp -p "$d"/*.md "$OUT/skills/$(basename "$d")/"; done
cp -p "$ROOT"/core/commands/*.md "$OUT/commands/"
cp -R "$ROOT"/core/rules/. "$OUT/rules/"
cp -p "$ROOT"/core/workflows/*.js "$OUT/workflows/" 2>/dev/null || true
cp -p "$ROOT"/bin/acp "$ROOT"/bin/wo "$ROOT"/bin/bug "$ROOT"/bin/pack "$ROOT"/bin/sanitize "$ROOT"/bin/detect-stack "$OUT/bin/"
mkdir -p "$OUT/hooks/scripts" "$OUT/hooks/rules"
cp -p "$ROOT"/core/hooks/*.py "$ROOT"/core/hooks/*.sh "$OUT/hooks/scripts/"
cp -p "$ROOT"/core/hooks/rules/*.md "$OUT/hooks/rules/"
# rule-hook.py looks for rules/ beside itself
ln -sfn ../rules "$OUT/hooks/scripts/rules"
mkdir -p "$OUT/templates"; cp -R "$ROOT"/core/templates/. "$OUT/templates/"
chmod +x "$OUT"/bin/* "$OUT"/hooks/scripts/*.py "$OUT"/hooks/scripts/*.sh

# Resolve template variables for plugin mode: the pipeline root is the plugin
# root; project layout falls back to the defaults baked into bin/wo.
render() {
  perl -pi -e 's/\{\{PIPELINE_ROOT\}\}/\$\{CLAUDE_PLUGIN_ROOT\}/g; s/\{\{PROJECT_ROOT\}\}\/\$\{CLAUDE_PLUGIN_ROOT\}/\$\{CLAUDE_PLUGIN_ROOT\}/g; s/\{\{WORKORDERS_DIR\}\}/Workspace\/Docs\/WorkOrders/g; s/\{\{BUGS_DIR\}\}/Workspace\/Docs\/Bugs/g; s/\{\{TESTING_DIR\}\}/Workspace\/Testing/g; s/\{\{SESSIONS_DIR\}\}/Workspace\/Sessions/g; s/\{\{DOCS_DIR\}\}/Workspace\/Docs/g; s/\{\{WORKSPACE_DIR\}\}/Workspace/g; s/\{\{PROJECT_NAME\}\}/the project/g; s/\{\{PROJECT_SLUG\}\}/project/g; s/\{\{[A-Z_]+\}\}//g' "$@"
}
while IFS= read -r f; do render "$f"; done < <(find "$OUT/skills" "$OUT/commands" "$OUT/agents" "$OUT/templates" -type f -name '*.md')

# hooks.json: same graph as core/config/settings.hooks.json, rooted at the plugin
python3 - "$ROOT/core/config/settings.hooks.json" "$OUT/hooks/hooks.json" <<'PY'
import json, sys
src, dst = sys.argv[1:3]
d = json.load(open(src))
def fix(cmd):
    return (cmd.replace("{{PROJECT_ROOT}}/{{PIPELINE_ROOT}}/core/hooks/", "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/"))
for ev in d["hooks"].values():
    for entry in ev:
        for h in entry.get("hooks", []):
            h["command"] = fix(h["command"])
json.dump(d, open(dst, "w"), indent=2)
PY

cat > "$OUT/.claude-plugin/plugin.json" <<JSON
{
  "name": "aicodepipeline",
  "version": "$VERSION",
  "description": "Christian Torres's AI engineering pipeline: an evidence-gated work-order lifecycle, a bug lifecycle, packs of precedent, a behavioral test harness, 47 agents, skills, hooks with profiles, and per-language rules.",
  "author": { "name": "Christian Torres", "url": "https://github.com/ChrisTorres404" },
  "homepage": "https://github.com/ChrisTorres404/AICodePipeline",
  "repository": "https://github.com/ChrisTorres404/AICodePipeline",
  "license": "MIT",
  "keywords": ["work-orders", "evidence", "behavioral-testing", "agents", "skills", "hooks", "rules", "methodology"],
  "userConfig": {
    "hook_profile": { "type": "string", "title": "Hook profile", "description": "minimal, standard, or strict", "default": "standard" }
  },
  "mcpServers": {},
  "commands": ["./commands/"],
  "skills": ["./skills/"]
}
JSON
cat > "$OUT/.claude-plugin/marketplace.json" <<JSON
{
  "name": "aicodepipeline",
  "owner": { "name": "Christian Torres" },
  "metadata": { "description": "AICodePipeline — evidence-gated engineering with AI agents" },
  "plugins": [ {
    "name": "aicodepipeline", "source": "./", "version": "$VERSION",
    "description": "Work orders that close only on executed evidence, packs of precedent, a behavioral harness, 46 agents, skills, hooks, and per-language rules.",
    "author": { "name": "Christian Torres" }, "license": "MIT", "category": "workflow",
    "keywords": ["work-orders", "evidence", "testing", "agents", "hooks", "rules"], "strict": false
  } ]
}
JSON
cp -p "$ROOT/LICENSE" "$ROOT/THIRD-PARTY-NOTICES.md" "$OUT/"
cat > "$OUT/README.md" <<'MD'
# AICodePipeline plugin

Install: `claude plugin add <path-or-repo>` then `/plugin install aicodepipeline`.

Work orders live in `Workspace/Docs/WorkOrders/` under the git root by default.
Drivers: `${CLAUDE_PLUGIN_ROOT}/bin/acp` (front door), `wo`, `bug`, `pack`, `sanitize`, `detect-stack`.
Hook profile: `ACP_HOOK_PROFILE=minimal|standard|strict`.

Rules are not auto-installed in plugin mode; copy the sets you need from
`rules/` into your project's `.claude/rules/`, or use `bin/install.sh` from the
full repository for the managed layout.
MD
echo "built $OUT ($(find "$OUT" -type f | wc -l | tr -d ' ') files)"
echo "  agents=$(ls "$OUT/agents" | wc -l | tr -d ' ') skills=$(ls "$OUT/skills" | wc -l | tr -d ' ') commands=$(ls "$OUT/commands" | wc -l | tr -d ' ') rules=$(ls "$OUT/rules" | wc -l | tr -d ' ') hooks=$(python3 -c "import json;print(sum(len(v) for v in json.load(open('$OUT/hooks/hooks.json'))['hooks'].values()))")"
unresolved="$(grep -rhoE '\{\{[A-Z_]+\}\}' "$OUT" | sort -u || true)"; [ -n "$unresolved" ] && echo "  WARNING unresolved: $unresolved" || echo "  no unresolved template variables"
