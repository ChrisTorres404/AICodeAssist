# ============================================================================
# Behavioral Test Configuration - LOCAL Environment
# ============================================================================
# This configuration targets LOCAL native PostgreSQL and services
# Use: source {{TESTING_DIR}}/config/local.env before running tests
# ============================================================================

# Environment Identifier
export TEST_ENV="LOCAL"

# API Configuration
export API_BASE="http://localhost:3001/api/v1"
export API_PORT="3001"
export ORIGIN="http://localhost:8600"

# Database Configuration (LOCAL PostgreSQL)
export DB_HOST="localhost"
export DB_PORT="5432"
export DB_USER="${DB_USER:-$USER}"
export DB_PASS=""  # No password for local
export DB_NAME="{{DB_NAME}}"

# Redis Configuration (LOCAL)
export REDIS_HOST="localhost"
export REDIS_PORT="6379"
export REDIS_PASSWORD=""

# Email Testing (Mailpit - LOCAL Docker or Native)
export MAILPIT_WEB="http://localhost:4225"
export MAILPIT_API="http://localhost:4225/api"
export MAILPIT_SMTP="localhost:4226"

# Test User Defaults
export DEFAULT_TENANT_ID="1"
export TEST_PASSWORD="TestPassword123!"

# Test Behavior
export VERBOSE="${VERBOSE:-false}"
export STOP_ON_FAIL="${STOP_ON_FAIL:-false}"
export CLEANUP_USERS="${CLEANUP_USERS:-true}"

# Colors (for test output)
export ENABLE_COLORS="${ENABLE_COLORS:-true}"

echo "[TEST CONFIG] Loaded LOCAL environment configuration"
echo "  API: ${API_BASE}"
echo "  DB: ${DB_USER}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
echo "  Redis: ${REDIS_HOST}:${REDIS_PORT}"
