# ============================================================================
# Behavioral Test Configuration — LOCAL environment
# ============================================================================
# A thin wrapper around test-config.env so a suite or shell can opt into the
# local stack without setting ACTIVE_ENV by hand:
#
#   source {{TESTING_DIR}}/config/local.env
#
# Every value lives in test-config.env — this file exists only to select the
# environment, so the two can never drift apart.
# ============================================================================

ACTIVE_ENV="LOCAL_DEV"
export ACTIVE_ENV

_local_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=./test-config.env
. "$_local_env_dir/test-config.env"
unset _local_env_dir

echo "[TEST CONFIG] Loaded LOCAL environment configuration"
echo "  API:   ${API_BASE}"
echo "  DB:    ${DB_USER}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
echo "  Redis: ${REDIS_HOST}:${REDIS_PORT}"
