# ============================================================================
# MASTER Behavioral Test Suite Configuration
# ============================================================================
# Single source of truth for ALL behavioral tests
# All test scripts should source this file:
#   source "$(dirname "$0")/../config/test-config.env"
#
# Update this file to switch environments for entire test suite
# ============================================================================

# ============================================================================
# ENVIRONMENT SELECTION
# ============================================================================
# Set ACTIVE_ENV to switch between environments:
#   - LOCAL_DEV: Local PostgreSQL ({{DB_NAME}})
#   - LOCAL_TEST: Local PostgreSQL (fresh test database)
#   - DOCKER: Docker containerized services
# ============================================================================
export ACTIVE_ENV="${ACTIVE_ENV:-LOCAL_DEV}"

# ============================================================================
# LOCAL_DEV Configuration (Default)
# ============================================================================
if [ "$ACTIVE_ENV" = "LOCAL_DEV" ]; then
  export API_BASE="http://localhost:8601/api/v1"
  export API_PORT="8601"
  export ORIGIN="http://localhost:8600"

  export DB_HOST="localhost"
  export DB_PORT="5432"
  export DB_USER="${DB_USER:-$USER}"
  export DB_PASS=""
  export DB_NAME="{{DB_NAME}}"

  export REDIS_HOST="localhost"
  export REDIS_PORT="6379"
  export REDIS_PASSWORD=""

  export ENV_LABEL="LOCAL DEV ({{DB_NAME}})"

# ============================================================================
# LOCAL_TEST Configuration (Fresh Test Database)
# ============================================================================
elif [ "$ACTIVE_ENV" = "LOCAL_TEST" ]; then
  export API_BASE="http://localhost:8601/api/v1"
  export API_PORT="8601"
  export ORIGIN="http://localhost:8600"

  export DB_HOST="localhost"
  export DB_PORT="5432"
  export DB_USER="${DB_USER:-$USER}"
  export DB_PASS=""
  export DB_NAME="{{PROJECT_SLUG}}_fresh_db_test_010"

  export REDIS_HOST="localhost"
  export REDIS_PORT="6379"
  export REDIS_PASSWORD=""

  export ENV_LABEL="LOCAL TEST ({{PROJECT_SLUG}}_fresh_db_test_010)"

# ============================================================================
# DOCKER Configuration
# ============================================================================
elif [ "$ACTIVE_ENV" = "DOCKER" ]; then
  export API_BASE="http://localhost:4201/api/v1"
  export API_PORT="4201"
  export ORIGIN="http://localhost:4200"

  export DB_HOST="localhost"
  export DB_PORT="4232"
  export DB_USER="{{PROJECT_SLUG}}"
  export DB_PASS="password"
  export DB_NAME="{{DB_NAME}}"

  export REDIS_HOST="localhost"
  export REDIS_PORT="4239"
  export REDIS_PASSWORD=""

  export ENV_LABEL="DOCKER ({{DB_NAME}})"

else
  echo "ERROR: Unknown ACTIVE_ENV='$ACTIVE_ENV'"
  echo "Valid options: LOCAL_DEV, LOCAL_TEST, DOCKER"
  exit 1
fi

# ============================================================================
# Common Configuration (All Environments)
# ============================================================================
export MAILPIT_WEB="http://localhost:4225"
export MAILPIT_API="http://localhost:4225/api"
export MAILPIT_SMTP="localhost:4226"

export DEFAULT_TENANT_ID="1"
export DEFAULT_TENANT_SLUG="{{PROJECT_SLUG}}-platform"

# Portal origin — use for non-admin user logins (admin console restricts to platform owners)
export PORTAL_ORIGIN="http://localhost:8604"

# ============================================================================
# Test Credentials
# ============================================================================
# These credentials are used by behavioral tests. Update these values
# to match your environment. NEVER commit real production credentials.
# ============================================================================

# Admin user (platform owner with full privileges)
export ADMIN_EMAIL="${ADMIN_EMAIL:-admin@{{PROJECT_DOMAIN}}}"
export ADMIN_PASSWORD="${ADMIN_PASSWORD:-Admin1223!}"

# Standard test user password (used for dynamically created test users)
export TEST_PASSWORD="${TEST_PASSWORD:-TestPassword123!}"
export TEST_WRONG_PASSWORD="${TEST_WRONG_PASSWORD:-WrongPassword123!}"

# Test email domain (for dynamically generated test users)
export TEST_EMAIL_DOMAIN="${TEST_EMAIL_DOMAIN:-example.com}"

# Test user prefixes (tests append random/sequential suffixes)
export TEST_USER_PREFIX="${TEST_USER_PREFIX:-wo_test_}"

# Temp password for password change/reset flows
export TEST_TEMP_PASSWORD="${TEST_TEMP_PASSWORD:-TempPassword123!}"

# ============================================================================
# Persistent Test Tenants  (PROJECT OVERLAY — replace per project)
# ============================================================================
# Define one block per long-lived test tenant your suites depend on.
# Secrets MUST come from the environment. Never hardcode a real client id,
# client secret, or token in this file — it is committed to the repo.
#
#   export TENANT_A_ADMIN_EMAIL="${TENANT_A_ADMIN_EMAIL:-admin@example.com}"
#   export TENANT_A_ADMIN_PASSWORD="${TENANT_A_ADMIN_PASSWORD:?set in your shell}"
#   export TENANT_A_TENANT_SLUG="${TENANT_A_TENANT_SLUG:-tenant-a}"
#   export TENANT_A_OAUTH_CLIENT_ID="${TENANT_A_OAUTH_CLIENT_ID:?set in your shell}"
# ============================================================================

# Edge-case test passwords
export TEST_VIEWER_PASSWORD="${TEST_VIEWER_PASSWORD:-ViewerTest1223!}"
export TEST_MFA_PASSWORD="${TEST_MFA_PASSWORD:-MfaTest1223!}"
export TEST_SUSPENDED_PASSWORD="${TEST_SUSPENDED_PASSWORD:-SuspendedTest1223!}"
export TEST_LOCKED_PASSWORD="${TEST_LOCKED_PASSWORD:-LockedTest1223!}"
export TEST_MULTI_TENANT_PASSWORD="${TEST_MULTI_TENANT_PASSWORD:-MultiTest1223!}"

export VERBOSE="${VERBOSE:-false}"
export STOP_ON_FAIL="${STOP_ON_FAIL:-false}"
export CLEANUP_USERS="${CLEANUP_USERS:-true}"
export ENABLE_COLORS="${ENABLE_COLORS:-true}"
export SHOW_CONFIG="${SHOW_CONFIG:-false}"

# ============================================================================
# Configuration Display
# ============================================================================
if [ "${VERBOSE}" = "true" ] || [ "${SHOW_CONFIG}" = "true" ]; then
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  BEHAVIORAL TEST SUITE - Configuration Loaded"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  Environment: ${ENV_LABEL}"
  echo "  API: ${API_BASE}"
  echo "  DB: ${DB_USER}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
  echo "  Redis: ${REDIS_HOST}:${REDIS_PORT}"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
fi

# ============================================================================
# Usage Instructions
# ============================================================================
# To switch environments, set ACTIVE_ENV before sourcing:
#
#   ACTIVE_ENV=LOCAL_DEV source {{TESTING_DIR}}/config/test-config.env
#   ACTIVE_ENV=LOCAL_TEST source {{TESTING_DIR}}/config/test-config.env
#   ACTIVE_ENV=DOCKER source {{TESTING_DIR}}/config/test-config.env
#
# Or export it first:
#   export ACTIVE_ENV=LOCAL_TEST
#   ./{{TESTING_DIR}}/suites/wo-0101-example.sh
# ============================================================================
